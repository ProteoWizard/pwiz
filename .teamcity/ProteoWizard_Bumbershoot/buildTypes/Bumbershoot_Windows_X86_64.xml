<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="4e912314-cfab-43a1-a808-3cd76fd43306" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Bumbershoot Windows x86_64</name>
  <description>Bumbershoot is the suite of tools produced by the Tabb Lab at Vanderbilt, which now proudly call ProteoWizard home. This is the 64-bit Windows variant.</description>
  <settings>
    <inherits>
      <ref id="ProteoWizard_GitHubReportingConfig" />
      <ref id="ProteoWizard_WindowsBase" />
    </inherits>
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="artifactRules" value="build-nt-x86/*.msi&#xA;build-nt-x86/Bumbershoot/*.tar.bz2&#xA;build-nt-x86/Bumbershoot/VERSION&#xA;build-nt-x86/IDPICKER_VERSION" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="%WINDOWS_CHECKOUT_DIR%" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="60" />
    </options>
    <disabled-settings>
      <setting-ref ref="RQ_1353" />
      <setting-ref ref="RUNNER_322" />
      <setting-ref ref="RUNNER_325" />
      <setting-ref ref="vcsTrigger" />
    </disabled-settings>
    <parameters>
      <param name="env.VSAPPIDDIR" value="C:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\" />
      <param name="env.address_model_property" value="address-model=64" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_198" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="scripts/misc/tcbuild.bat" />
          <param name="command.parameters" value="--i-agree-to-the-vendor-licenses --automated pwiz_tools/Bumbershoot pwiz_tools/Bumbershoot//bumbershoot-bin.tar.bz2 pwiz_tools/Bumbershoot/idpicker/Deploy//setup.exe -j%env.NUMBER_OF_CORES% %env.toolset_property% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property%" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_321" name="Build Test.dll" type="dotnet">
        <parameters>
          <param name="command" value="msbuild" />
          <param name="configuration" value="Release" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="msbuild.version" value="MSBuild_17_Windows" />
          <param name="paths" value="pwiz_tools/Bumbershoot/idpicker/IDPicker.sln" />
          <param name="required.sdk" value="4.7.2" />
          <param name="targets" value="Build" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_322" name="Run IDPicker tests" type="VisualStudioTest">
        <parameters>
          <param name="dotNetCoverage.NCover.HTMLReport.File.Sort" value="0" />
          <param name="dotNetCoverage.NCover.HTMLReport.File.Type" value="1" />
          <param name="dotNetCoverage.NCover.Reg" value="selected" />
          <param name="dotNetCoverage.NCover.platformBitness" value="x86" />
          <param name="dotNetCoverage.NCover.platformVersion" value="v2.0" />
          <param name="dotNetCoverage.NCover3.Reg" value="selected" />
          <param name="dotNetCoverage.NCover3.args" value="//ias .*" />
          <param name="dotNetCoverage.NCover3.platformBitness" value="x86" />
          <param name="dotNetCoverage.NCover3.platformVersion" value="v2.0" />
          <param name="dotNetCoverage.NCover3.reporter.executable.args" value="//or FullCoverageReport:Html:{teamcity.report.path}" />
          <param name="dotNetCoverage.PartCover.Reg" value="selected" />
          <param name="dotNetCoverage.PartCover.includes" value="[*]*" />
          <param name="dotNetCoverage.PartCover.platformBitness" value="x86" />
          <param name="dotNetCoverage.PartCover.platformVersion" value="v2.0" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="dotNetTestRunner.Type" value="GenericProcess" />
          <param name="mstest_enable" value="checked" />
          <param name="teamcity.step.mode" value="default" />
          <param name="vstest_engine" value="MSTest" />
          <param name="vstest_framework" value="default" />
          <param name="vstest_include" value="build-nt-x86/msvc-release-x86_64/Test.dll" />
          <param name="vstest_platform" value="x86" />
          <param name="vstest_runner_path" value="%teamcity.dotnet.mstest.16.0%" />
          <param name="vstest_runsettings" value="pwiz_tools/Bumbershoot/idpicker/Local-x64.testrunconfig" />
        </parameters>
      </runner>
      <runner id="RUNNER_325" name="Run IDPicker tests (1)" type="dotnet">
        <parameters>
          <param name="command" value="vstest" />
          <param name="dotNetCoverage.dotCover.home.path" value="%teamcity.tool.JetBrains.dotCover.CommandLineTools.DEFAULT%" />
          <param name="framework" value="Framework45" />
          <param name="paths" value="build-nt-x86/msvc-release-x86_64/Test.dll" />
          <param name="platform" value="x64" />
          <param name="required.sdk" value="4.7.2" />
          <param name="teamcity.step.mode" value="default" />
          <param name="vstest.version" value="VSTest_17_Windows" />
        </parameters>
      </runner>
      <runner id="RUNNER_74" name="" type="ProteoWizard_UploadArtifactMetadataToSourceForge">
        <parameters>
          <param name="WINDOWS_CHECKOUT_DIR" value="Z:\pwiz" />
          <param name="WINDOWS_SKYLINE_RELEASE_CHECKOUT_DIR" value="C:\skyline_release" />
          <param name="env.NUMBER_OF_CORES" value="%teamcity.agent.hardware.cpuCount%" />
          <param name="env.PYTHON_HOME" value="C:\Python38" />
          <param name="system.artifact.paths" value="build-nt-x86/*.msi,build-nt-x86/Bumbershoot/*.tar.bz2,build-nt-x86/Bumbershoot/VERSION,build-nt-x86/IDPICKER_VERSION" />
          <param name="teamcity.activeBuildBranch.age.hours" value="0" />
          <param name="teamcity.activeVcsBranch.age.days" value="3" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1352" name="teamcity.agent.jvm.os.name" value="Windows" />
      <exists id="RQ_1353" name="env.VS120COMNTOOLS" />
      <not-exists id="RQ_1354" name="VS2013" />
      <does-not-contain id="RQ_49" name="teamcity.agent.name" value="MacCoss" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="branchFilter"><![CDATA[+:*
-:Skyline/*]]></param>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="61" />
          <param name="quietPeriodMode" value="USE_CUSTOM" />
          <param name="triggerRules"><![CDATA[+:.
-:README.md
-:.travis.yml
-:appveyor.yml
-:.gitignore
-:pwiz_tools/Bumbershoot/idpicker/Website/**
-:pwiz_tools/BiblioSpec/**
-:pwiz_tools/Skyline/**
-:pwiz_tools/Topograph/**
-:pwiz_tools/MSConvertGUI/**]]></param>
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_693" type="teamcity.github.status">
        <parameters>
          <param name="github_report_on" value="on start and finish" />
          <param name="guthub_authentication_type" value="token" />
          <param name="guthub_context" value="teamcity - %system.teamcity.buildConfName%" />
          <param name="guthub_guest" value="true" />
          <param name="guthub_host" value="https://api.github.com" />
          <param name="guthub_owner" value="ProteoWizard" />
          <param name="guthub_repo" value="pwiz" />
          <param name="secure:github_access_token" value="credentialsJSON:b249da28-7099-46bd-b976-5efcef2bbca2" />
        </parameters>
      </extension>
    </build-extensions>
    <cleanup>
      <policy type="days" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="60" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

