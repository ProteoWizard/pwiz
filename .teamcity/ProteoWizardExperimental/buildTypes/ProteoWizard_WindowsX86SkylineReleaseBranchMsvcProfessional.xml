<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="0b5ce46e-0f08-4d5f-b4cb-72570e9e2ce0" paused="true" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Skyline Release Branch x86</name>
  <description>Builds 32 bit on changes to branch declared in Skyline Release VCS</description>
  <settings>
    <inherits>
      <ref id="ProteoWizard_GitHubReportingConfig" />
      <ref id="ProteoWizard_WindowsBase" />
    </inherits>
    <options>
      <option name="artifactRules" value="build-nt-x86/*.tar.bz2&#xA;pwiz_tools/Skyline/TestResults/*.trx&#xA;pwiz_tools/Topograph/TestResults/*.trx&#xA;pwiz_tools/Skyline/bin/x86/Release/SkylineTester.zip&#xA;pwiz_tools/Skyline/bin/x86/Release/SkylineNightly.zip" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="skyline_release" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="360" />
    </options>
    <disabled-settings>
      <setting-ref ref="RQ_1993" />
      <setting-ref ref="RQ_1994" />
    </disabled-settings>
    <parameters>
      <param name="env.address_model_property" value="address-model=32" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.toolset_property" value="toolset=msvc-14.1" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_201" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="scripts\misc\tcbuild-apps.bat" />
          <param name="command.parameters" value="32 pwiz_tools\Skyline pwiz_tools\Topograph --i-agree-to-the-vendor-licenses -j%env.NUMBER_OF_CORES% %env.toolset_property% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property%" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubSkylineReleaseOnlyWithPRs1" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1992" name="teamcity.agent.jvm.os.name" value="Windows" />
      <exists id="RQ_1993" name="VS2013" />
      <exists id="RQ_1994" name="env.VS120COMNTOOLS" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:&lt;default&gt;" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="60" />
          <param name="quietPeriodMode" value="USE_DEFAULT" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <cleanup>
      <policy type="builds" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepBuilds.count" value="1" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

