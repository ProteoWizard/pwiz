<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="be94ecbf-a03c-4d54-8e49-c16a2c2d5d7c" paused="true" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Linux x86 link=shared</name>
  <description />
  <settings>
    <options>
      <option name="artifactRules" value="build-linux-x86_64/*.tar.bz2&#xA;build-linux-x86_64/VERSION" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="pwiz" />
      <option name="checkoutMode" value="ON_AGENT" />
    </options>
    <parameters>
      <param name="env.address_model_property" value="address-model=32" />
      <param name="env.architecture_property" value="architecture=x86" />
      <param name="env.link_property" value="link=shared" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_simpleRunner_147" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="/bin/bash" />
          <param name="command.parameters" value="scripts/misc/tcbuild.sh pwiz-bin.tar.bz2 pwiz pwiz_aux pwiz_tools -j%env.NUMBER_OF_CORES% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property%" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizardAtSourceForge" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_925" name="teamcity.agent.jvm.os.name" value="Linux" />
      <equals id="RQ_926" name="teamcity.agent.jvm.os.arch" value="i386" />
      <exists id="RQ_927" name="env.MSPARSER_HOME" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="60" />
          <param name="quietPeriodMode" value="USE_DEFAULT" />
        </parameters>
      </build-trigger>
    </build-triggers>
  </settings>
</build-type>

