<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="ed4f7fa2-24c3-45e8-9725-1068f85c8560" paused="true" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>BiblioSpec subset source tarball</name>
  <description />
  <settings ref="ProteoWizard_GitHubReportingConfig">
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="artifactRules" value="build-linux-x86_64/BiblioSpec/*-src-*.tar.bz2&#xA;build-linux-x86_64/BiblioSpec/VERSION" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="pwiz" />
      <option name="checkoutMode" value="ON_AGENT" />
    </options>
    <build-runners>
      <runner id="RUNNER_785" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="scripts/misc/tcbuild.sh" />
          <param name="command.parameters" value="pwiz_tools/BiblioSpec//bibliospec-src.tar.bz2 pwiz_tools/BiblioSpec//bibliospec-src-without-t.tar.bz2 -j%env.NUMBER_OF_CORES% toolset=gcc-5 address-model=64" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_964" name="teamcity.agent.jvm.os.name" value="Linux" />
      <equals id="RQ_965" name="teamcity.agent.jvm.os.arch" value="amd64" />
    </requirements>
    <build-triggers>
      <build-trigger id="retryBuildTrigger" type="retryBuildTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enqueueTimeout" value="120" />
          <param name="reRunBuildWithTheSameRevisions" value="true" />
          <param name="retryAttempts" value="3" />
        </parameters>
      </build-trigger>
    </build-triggers>
  </settings>
</build-type>

