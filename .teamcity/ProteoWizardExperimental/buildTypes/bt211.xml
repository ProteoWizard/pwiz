<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="79978c2c-42f4-4a8e-8dd6-b4e8da3ffa62" paused="true" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Alternate build system: create MSVC project files for libpwiz</name>
  <description>Creates MSVC (8/9/10) project files for use in existing non-ProteoWizard projects</description>
  <settings>
    <options>
      <option name="artifactRules" value="%teamcity.build.checkoutDir%/build-nt-x86/libpwiz_msvc_*.zip&#xA;%teamcity.build.checkoutDir%/build-nt-x86/VERSION" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="pwiz" />
      <option name="checkoutMode" value="ON_AGENT" />
    </options>
    <build-runners>
      <runner id="RUNNER_simpleRunner_119" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="make_nonbjam_build.bat" />
          <param name="command.parameters" value="%teamcity.build.checkoutDir% -d" />
          <param name="teamcity.build.workingDir" value="%teamcity.build.checkoutDir%/scripts/autotools" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_Github" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_618" name="teamcity.agent.jvm.os.name" value="Windows" />
    </requirements>
    <build-triggers>
      <build-trigger id="TRIGGER_65" type="schedulingTrigger">
        <parameters>
          <param name="cronExpression_dm" value="*" />
          <param name="cronExpression_dw" value="?" />
          <param name="cronExpression_hour" value="*" />
          <param name="cronExpression_min" value="0" />
          <param name="cronExpression_month" value="*" />
          <param name="cronExpression_sec" value="0" />
          <param name="cronExpression_year" value="*" />
          <param name="dayOfWeek" value="Sunday" />
          <param name="enableQueueOptimization" value="true" />
          <param name="hour" value="0" />
          <param name="minute" value="0" />
          <param name="schedulingPolicy" value="daily" />
          <param name="triggerBuildWithPendingChangesOnly" value="true" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="perfmon" type="perfmon" />
    </build-extensions>
  </settings>
</build-type>

