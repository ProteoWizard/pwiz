          <param name="jetbrains.buildServer.deployer.ssh.transport" value="jetbrains.buildServer.deployer.ssh.transport.sftp" />
          <param name="jetbrains.buildServer.deployer.targetUrl" value="web.sf.net:/home/project-web/proteowizard/htdocs/releases" />
          <param name="jetbrains.buildServer.deployer.username" value="chambm" />
          <param name="jetbrains.buildServer.sshexec.authMethod" value="UPLOADED_KEY" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcitySshKey" value="chambm@sourceforge.net-ed25519" />
        </parameters>
      </runner>
