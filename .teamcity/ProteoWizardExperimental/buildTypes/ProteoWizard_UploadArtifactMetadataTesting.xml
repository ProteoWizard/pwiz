          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="ProteoWizard_UploadArtifactMetadataToSourceForge_1" name="Download artifacts metadata for current build" type="python-runner">
        <conditions>
          <does-not-equal name="env.BUILD_IS_PERSONAL" value="true" />
        </conditions>
        <parameters>
          <param name="command" value="script" />
          <param name="coverageArgs" value="--omit=*lib*" />
          <param name="envTool" value="none" />
          <param name="installToolPackage" value="true" />
          <param name="isCoverageEnabled" value="false" />
          <param name="isTestReportingEnabled" value="true" />
          <param name="poetryExecutable" value="poetry" />
          <param name="pythonVersion" value="python3" />
          <param name="scriptContent"><![CDATA[import os, sys, re
import urllib.request
from time import sleep
from glob import glob
from os.path import isfile, join

configFilename = '%system.teamcity.buildType.id%.xml'
artifactPathmasks = r'''%system.artifact.paths%'''
metadataFile = open(configFilename, "w")
metadataFile.write("<artifacts>")
        
for pathmask in artifactPathmasks.split('\n'):
  print(pathmask)
  for f in glob(pathmask):
    if isfile(f):
      metadataFile.write("<artifact>/guestAuth/app/rest/builds/id:%teamcity.build.id%/artifacts/content/" + f + "</artifact>")
metadataFile.write("</artifacts>")
metadataFile.close()]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="virtualenvEnvName" value=".venv" />
          <param name="virtualenvFile" value="requirements.txt" />
        </parameters>
      </runner>
      <runner id="ProteoWizard_UploadArtifactMetadataToSourceForge_2" name="Upload artifact metadata to SourceForge" type="ssh-deploy-runner">
        <conditions>
