<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="96c8a790-1c7c-4b6e-88fe-2806f7b5255c" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Alternate build system: test VC10 libpwiz build</name>
  <description>Tests the sln and vcxproj files produced by "MSVC project files for libpwiz"</description>
  <settings>
    <options>
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="libpwiz_test" />
      <option name="checkoutMode" value="MANUAL" />
      <option name="cleanBuild" value="true" />
    </options>
    <parameters>
      <param name="env.BOOST_ROOT" value="C:\local\boost_1_53_0" />
      <param name="env.ZLIB_SOURCE" value="%teamcity.build.checkoutDir%\libraries\zlib-1.2.3" />
      <param name="env.toolset_property" value="toolset=msvc-10.0" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_6" name="show boost version" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="../pwiz/scripts/misc/show_boostver.bat" />
        </parameters>
      </runner>
      <runner id="RUNNER_VS.Solution_120" name="" type="VS.Solution">
        <parameters>
          <param name="build-file-path" value="pwiz/msvc10/libpwiz.sln" />
          <param name="msbuild.prop.Configuration" value="Release" />
          <param name="msbuild_version" value="4.0" />
          <param name="run-platform" value="x86" />
          <param name="runnerArgs" value="/verbosity:quiet" />
          <param name="targets" value="Build" />
          <param name="toolsVersion" value="4.0" />
          <param name="vs.version" value="vs2010" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizardAtSourceForge" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_665" name="teamcity.agent.jvm.os.name" value="Windows" />
      <exists id="RQ_666" name="VS2010" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="-1" />
          <param name="quietPeriodMode" value="USE_CUSTOM" />
        </parameters>
      </build-trigger>
      <build-trigger id="TRIGGER_66" type="buildDependencyTrigger">
        <parameters>
          <param name="afterSuccessfulBuildOnly" value="true" />
          <param name="dependsOn" value="bt211" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <artifact-dependencies>
      <dependency id="ARTIFACT_DEPENDENCY_730" sourceBuildTypeId="bt211" cleanDestination="false">
        <revisionRule name="sameChainOrLastFinished" revision="latest.sameChainOrLastFinished" />
        <artifact sourcePath="libpwiz_msvc_*.zip!**" />
      </dependency>
    </artifact-dependencies>
    <dependencies>
      <depend-on sourceBuildTypeId="bt211">
        <options>
          <option name="take-started-build-with-same-revisions" value="true" />
          <option name="take-successful-builds-only" value="true" />
        </options>
      </depend-on>
    </dependencies>
  </settings>
</build-type>

