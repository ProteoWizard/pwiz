import urllib.request
from time import sleep

configFilename = '%system.teamcity.buildType.id%.xml'

def hasMatch(filename, searchForText):
    with open(configFilename) as config:
        for line in config.readlines():
            if re.search(searchForText, line):
                return True
    return False

for i in range(0,10):
    sleep(3)
    print("https://teamcity.labkey.org/guestAuth/app/rest/builds/id:%teamcity.build.id%/artifacts/children")
    urllib.request.urlretrieve('https://teamcity.labkey.org/guestAuth/app/rest/builds/id:%teamcity.build.id%/artifacts/children', configFilename)
    if hasMatch(configFilename, "<content href"):
        sys.exit(0)

# no artifacts found after 30 seconds
sys.exit(1)]]></param>
