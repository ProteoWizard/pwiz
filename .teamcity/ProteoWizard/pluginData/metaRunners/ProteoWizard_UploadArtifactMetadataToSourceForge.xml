<meta-runner name="Upload artifact metadata to SourceForge">
  <description>Upload artifact metadata for the current build configuration.</description>
  <settings>
    <parameters>
      <param name="GitHubAuthToken" value="zxx05ef5a299ed0b0f46b4c7898ed776994a1ef0772e2a810cd95ed0b7dca611361dfec53604fd8827c775d03cbe80d301b" spec="password display='hidden' label='GitHubAuthToken'" />
      <param name="WINDOWS_CHECKOUT_DIR" value="Z:\pwiz" spec="text orderNumber='2.0'" />
      <param name="WINDOWS_SKYLINE_RELEASE_CHECKOUT_DIR" value="C:\skyline_release" spec="text orderNumber='3.0'" />
      <param name="env.NUMBER_OF_CORES" value="%teamcity.agent.hardware.cpuCount%" spec="text orderNumber='4.0'" />
      <param name="env.PYTHON_HOME" value="C:\Python38" spec="text orderNumber='5.0'" />
      <param name="system.artifact.paths" value="" />
      <param name="teamcity.activeBuildBranch.age.hours" value="0" spec="text orderNumber='6.0'" />
      <param name="teamcity.activeVcsBranch.age.days" value="3" spec="text orderNumber='7.0'" />
    </parameters>
    <build-runners>
      <runner name="Upgrade certifi" type="pip_upgrade_certifi">
      </runner>
      <runner name="Create artifacts metadata file for current build" type="python-runner">
        <conditions>
          <equals name="teamcity.build.branch.is_default" value="true" />
          <does-not-equal name="env.BUILD_IS_PERSONAL" value="true" />
        </conditions>
        <parameters>
          <param name="command" value="script" />
          <param name="coverageArgs" value="--omit=*lib*" />
          <param name="envTool" value="none" />
          <param name="installToolPackage" value="true" />
          <param name="isCoverageEnabled" value="false" />
          <param name="isTestReportingEnabled" value="true" />
          <param name="poetryExecutable" value="poetry" />
          <param name="pythonVersion" value="python3" />
          <param name="scriptContent"><![CDATA[import os, sys, re
import certifi
import urllib.request
from time import sleep
from glob import glob
from os.path import isfile, join

configPath = "artifact_xml"
os.makedirs(configPath, exist_ok=True)
configFilename = configPath + '/%system.teamcity.buildType.id%.xml'
metadataFile = open(configFilename, "w")
metadataFile.write("<artifacts>")

artifactPathmasks = r'''%system.artifact.paths%'''
for pathmask in artifactPathmasks.replace(',', '\n').split('\n'):
  print(pathmask)
  for f in glob(pathmask):
    if isfile(f):
      metadataFile.write("<artifact>/guestAuth/app/rest/builds/id:%teamcity.build.id%/artifacts/content/" + os.path.basename(f) + "</artifact>")
metadataFile.write("</artifacts>")
metadataFile.close()]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="virtualenvEnvName" value=".venv" />
          <param name="virtualenvFile" value="requirements.txt" />
        </parameters>
      </runner>
      <runner name="Upload artifact metadata to SourceForge" type="ssh-deploy-runner">
        <conditions>
          <equals name="teamcity.build.branch.is_default" value="true" />
          <does-not-equal name="env.BUILD_IS_PERSONAL" value="true" />
        </conditions>
        <parameters>
          <param name="jetbrains.buildServer.deployer.sourcePath" value="artifact_xml/*.xml" />
          <param name="jetbrains.buildServer.deployer.ssh.transport" value="jetbrains.buildServer.deployer.ssh.transport.sftp" />
          <param name="jetbrains.buildServer.deployer.targetUrl" value="web.sf.net:/home/project-web/proteowizard/htdocs/releases" />
          <param name="jetbrains.buildServer.deployer.username" value="chambm" />
          <param name="jetbrains.buildServer.sshexec.authMethod" value="UPLOADED_KEY" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcitySshKey" value="chambm@sourceforge.net-ed25519" />
        </parameters>
      </runner>
    </build-runners>
    <requirements />
  </settings>
</meta-runner>

