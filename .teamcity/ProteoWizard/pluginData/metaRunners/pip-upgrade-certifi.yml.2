name: pip-upgrade-certifi
title: pip-upgrade-certifi
description: Upgrades the Python certifi package using the TeamCity Python runner
steps:
  - name: Upgrade certifi with Python runner
    kotlin-script: "steps {\n    python {\n        name = \"Upgrade certifi\"\n  \
      \      command = script {\n            content = \"\"\"\n                import\
      \ os\n                import os.path\n                import ssl\n         \
      \       import subprocess\n                import sys\n                \n  \
      \              print(\" -- pip install --upgrade certifi\")\n              \
      \  subprocess.check_call([sys.executable, \"-E\", \"-s\", \"-m\", \"pip\", \"\
      install\", \"--upgrade\", \"certifi\"])\n            \"\"\".trimIndent()\n \
      \       }\n    }\n}\n"
