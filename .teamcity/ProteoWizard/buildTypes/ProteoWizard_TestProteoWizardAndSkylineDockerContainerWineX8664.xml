<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="6857ec55-6512-4f26-bb96-8ca510a6c32c" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>test ProteoWizard and Skyline Docker container (Wine x86_64)</name>
  <description>Builds the container from the latest binary snapshots</description>
  <settings ref="ProteoWizard_GitHubReportingConfig">
    <options>
      <option name="artifactRules" value="**/*.log =&gt; logs.tar.gz&#xA;**/*.diff =&gt; diffs.tar.gz&#xA;pwiz-skyline-i-agree-to-the-vendor-licenses.*&#xA;/tmp/pwiz-skyline-i-agree-to-the-vendor-licenses.*&#xA;%system.teamcity.build.tempDir%/*pwiz-skyline-i-agree-to-the-vendor-licenses_x64*.simg&#xA;-:**/duration.log&#xA;-:**/AcqData&#xA;-:**/method.log&#xA;-:TestRunner*.log&#xA;-:pwiz_tools/Skyline/**/*.log" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number.ProteoWizard_PwizGithubMasterWithPRs%)" />
      <option name="checkoutDirectory" value="pwiz-container-test" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="60" />
      <option name="showDependenciesChanges" value="true" />
    </options>
    <disabled-settings>
      <setting-ref ref="TRIGGER_1024" />
    </disabled-settings>
    <parameters>
      <param name="env.MSPARSER_HOME" value="" />
      <param name="env.address_model_property" value="" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.variant_property" value="release" />
      <param name="system.build.vcs.number" value="%system.build.vcs.number.ProteoWizard_GithubContainer%" />
      <param name="system.build.vcs.number.ProteoWizard_PwizGithubMasterWithPRs" value="1" />
    </parameters>
    <build-runners>
      <runner id="python_runner" name="" type="python-runner">
        <parameters>
          <param name="command" value="script" />
          <param name="coverageArgs" value="--omit=*lib*" />
          <param name="envTool" value="virtualenv" />
          <param name="installToolPackage" value="true" />
          <param name="isCoverageEnabled" value="false" />
          <param name="isTestReportingEnabled" value="true" />
          <param name="poetryExecutable" value="poetry" />
          <param name="pythonVersion" value="python3" />
          <param name="scriptContent"><![CDATA[import os, sys, re
import certifi
print("Setting SSL_CERT_FILE to: " + certifi.where())
print(f"##teamcity[setParameter name='env.SSL_CERT_FILE' value='{certifi.where()}']")]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="virtualenvEnvName" value=".venv" />
          <param name="virtualenvFile" value="requirements.txt" />
          <param name="virtualenvPipArgs" value="certifi" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_GithubContainer">
        <checkout-rule rule="+:. =&gt; container" />
      </vcs-entry-ref>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithoutPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_471" name="teamcity.agent.jvm.os.name" value="Linux" />
      <does-not-equal id="RQ_473" name="teamcity.agent.jvm.os.arch" value="i386" />
      <exists id="RQ_2033" name="docker.version" />
    </requirements>
    <build-triggers>
      <build-trigger id="TRIGGER_1024" type="schedulingTrigger">
        <parameters>
          <param name="branchFilter" value="-:Skyline/skyline_*" />
          <param name="cronExpression_dm" value="*" />
          <param name="cronExpression_dw" value="?" />
          <param name="cronExpression_hour" value="*" />
          <param name="cronExpression_min" value="0" />
          <param name="cronExpression_month" value="*" />
          <param name="cronExpression_sec" value="0" />
          <param name="cronExpression_year" value="*" />
          <param name="dayOfWeek" value="Sunday" />
          <param name="enableQueueOptimization" value="true" />
          <param name="hour" value="0" />
          <param name="minute" value="0" />
          <param name="revisionRule" value="lastFinished" />
          <param name="schedulingPolicy" value="daily" />
          <param name="timezone" value="SERVER" />
          <param name="triggerBuildWithPendingChangesOnly" value="true" />
          <param name="triggerRules"><![CDATA[+:.
-:pwiz_tools/SeeMS/**
-:pwiz_tools/MSConvertGUI/**]]></param>
        </parameters>
      </build-trigger>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="branchFilter"><![CDATA[+:*
-:Skyline/skyline_*]]></param>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
          <param name="triggerRules" value="+:container/Dockerfile" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_21" type="teamcity.github.status">
        <parameters>
          <param name="github_report_on" value="on start and finish" />
          <param name="guthub_authentication_type" value="token" />
          <param name="guthub_context" value="teamcity - %system.teamcity.buildConfName%" />
          <param name="guthub_host" value="https://api.github.com" />
          <param name="guthub_owner" value="ProteoWizard" />
          <param name="guthub_repo" value="container" />
          <param name="secure:github_access_token" value="credentialsJSON:f8fb99a5-f2ce-42ef-9ef4-8809c17e6b32" />
        </parameters>
      </extension>
    </build-extensions>
    <artifact-dependencies>
      <dependency id="ARTIFACT_DEPENDENCY_2279" sourceBuildTypeId="bt83" cleanDestination="false">
        <revisionRule name="sameChainOrLastFinished" revision="latest.sameChainOrLastFinished" />
        <artifact sourcePath="pwiz-bin-windows-*.tar.bz2 =&gt; container/artifacts" />
      </dependency>
      <dependency id="ARTIFACT_DEPENDENCY_2278" sourceBuildTypeId="bt209" cleanDestination="false">
        <revisionRule name="sameChainOrLastFinished" revision="latest.sameChainOrLastFinished" />
        <artifact sourcePath="SkylineTester.zip =&gt; container/artifacts" />
      </dependency>
    </artifact-dependencies>
    <dependencies>
      <depend-on sourceBuildTypeId="bt209">
        <options>
          <option name="run-build-if-dependency-failed" value="RUN_ADD_PROBLEM" />
          <option name="run-build-if-dependency-failed-to-start" value="CANCEL" />
          <option name="take-started-build-with-same-revisions" value="true" />
        </options>
      </depend-on>
      <depend-on sourceBuildTypeId="bt83">
        <options>
          <option name="run-build-if-dependency-failed" value="RUN_ADD_PROBLEM" />
          <option name="run-build-if-dependency-failed-to-start" value="CANCEL" />
          <option name="sync-revisions" value="false" />
          <option name="take-started-build-with-same-revisions" value="true" />
        </options>
      </depend-on>
    </dependencies>
    <cleanup>
      <policy type="days" cleanup-level="HISTORY_ENTRY">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="30" />
        </parameters>
      </policy>
      <policy type="builds" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns"><![CDATA[*.tbz2
*.simg]]></param>
          <param name="keepBuilds.count" value="1" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

