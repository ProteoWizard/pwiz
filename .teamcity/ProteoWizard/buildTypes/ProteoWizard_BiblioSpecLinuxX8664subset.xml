<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="cd386672-e6cc-426f-9b06-97f78e945042" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>BiblioSpec Linux x86_64 subset</name>
  <description>Builds the subset source tarball</description>
  <settings ref="ProteoWizard_GitHubReportingConfig">
    <options>
      <option name="artifactRules" value="src_subset/build-linux-x86_64/BiblioSpec/bibliospec-bin-*.tar.bz2" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="pwiz" />
      <option name="checkoutMode" value="ON_AGENT" />
    </options>
    <parameters>
      <param name="env.toolset_property" value="toolset=gcc-9" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_2201" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="/bin/bash" />
          <param name="command.parameters" value="scripts/misc/tcbuild-subset.sh -j%env.NUMBER_OF_CORES% %env.toolset_property% address-model=64 pwiz_tools/BiblioSpec//bibliospec-bin.tar.bz2" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_265" name="teamcity.agent.jvm.os.name" value="Linux" />
      <does-not-equal id="RQ_267" name="teamcity.agent.jvm.os.arch" value="i386" />
    </requirements>
    <build-triggers>
      <build-trigger id="TRIGGER_1041" type="buildDependencyTrigger">
        <parameters>
          <param name="afterSuccessfulBuildOnly" value="true" />
          <param name="branchFilter" value="+:&lt;default&gt;" />
          <param name="dependsOn" value="BiblioSpecSubsetSourceTarball" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <artifact-dependencies>
      <dependency id="ARTIFACT_DEPENDENCY_326" sourceBuildTypeId="BiblioSpecSubsetSourceTarball" cleanDestination="false">
        <revisionRule name="sameChainOrLastFinished" revision="latest.sameChainOrLastFinished" />
        <artifact sourcePath="*-src-without-t-*.tar.bz2=&gt;." />
      </dependency>
    </artifact-dependencies>
    <dependencies>
      <depend-on sourceBuildTypeId="BiblioSpecSubsetSourceTarball">
        <options>
          <option name="take-started-build-with-same-revisions" value="true" />
        </options>
      </depend-on>
    </dependencies>
  </settings>
</build-type>

