<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="32e259ca-67d7-4fca-9a41-9070bb856926" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Skyline Code Inspection</name>
  <description>Runs Resharper's code inspections, only on Skyline</description>
  <settings ref="ProteoWizard_GitHubReportingConfig">
    <options>
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="%WINDOWS_CHECKOUT_DIR%" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="90" />
    </options>
    <parameters>
      <param name="env.address_model_property" value="address-model=64" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.toolset_property" value="toolset=msvc-14.1" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_196" name="Skyline Code Inspection by Built-In TC Resharper" type="dotnet-tools-inspectcode">
        <parameters>
          <param name="TargetDotNetFramework_4.7.2" value="true" />
          <param name="dotnet-tools-inspectcode.customCmdArgs" value="&quot;--no-swea&quot; -e=WARNING &quot;--properties:Configuration=Release;Platform=x64&quot;" />
          <param name="dotnet-tools-inspectcode.debug" value="true" />
          <param name="dotnet-tools-inspectcode.solution" value="pwiz_tools/Skyline/Skyline.sln" />
          <param name="jetbrains.resharper-clt.clt-path" value="%teamcity.tool.jetbrains.resharper-clt.DEFAULT%" />
          <param name="jetbrains.resharper-clt.platform" value="x64" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1978" name="teamcity.agent.jvm.os.name" value="Windows" />
      <not-exists id="RQ_1979" name="VS2013" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="USE_DEFAULT" />
          <param name="triggerRules" value="+:%system.teamcity.build.checkoutDir%/pwiz_tools/Skyline/**" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_28" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="InspectionStatsE" />
          <param name="metricThreshold" value="2" />
          <param name="metricUnits" value="metricUnitsDefault" />
          <param name="moreOrLess" value="more" />
          <param name="withBuildAnchor" value="false" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_43" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="InspectionStatsW" />
          <param name="metricThreshold" value="0" />
          <param name="metricUnits" value="metricUnitsDefault" />
          <param name="moreOrLess" value="more" />
          <param name="withBuildAnchor" value="false" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_13" type="teamcity.github.status">
        <parameters>
          <param name="github_report_on" value="on start and finish" />
          <param name="guthub_authentication_type" value="token" />
          <param name="guthub_context" value="Skyline code inspection" />
          <param name="guthub_guest" value="true" />
          <param name="guthub_host" value="https://api.github.com" />
          <param name="guthub_owner" value="ProteoWizard" />
          <param name="guthub_repo" value="pwiz" />
          <param name="secure:github_access_token" value="credentialsJSON:f8fb99a5-f2ce-42ef-9ef4-8809c17e6b32" />
        </parameters>
      </extension>
    </build-extensions>
    <dependencies>
      <depend-on sourceBuildTypeId="bt209">
        <options>
          <option name="run-build-if-dependency-failed" value="RUN" />
          <option name="run-build-on-the-same-agent" value="true" />
          <option name="take-started-build-with-same-revisions" value="true" />
          <option name="take-successful-builds-only" value="true" />
        </options>
      </depend-on>
    </dependencies>
    <cleanup>
      <policy type="days" cleanup-level="EVERYTHING">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="365" />
        </parameters>
      </policy>
      <policy type="days" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="7" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

