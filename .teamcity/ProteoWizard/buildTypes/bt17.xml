<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="32579704-66d7-4833-8d86-90a2790f1ac9" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Core Linux x86_64</name>
  <description />
  <settings>
    <inherits>
      <ref id="ProteoWizard_GitHubReportingConfig" />
      <ref id="ProteoWizard_RemoteAccountTestParameters" />
    </inherits>
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="artifactRules" value="**/ProteoWizard-*.tar.gz&#xA;**/*.blib.observed" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="60" />
    </options>
    <build-runners order="RUNNER_simpleRunner_139">
      <runner id="RUNNER_simpleRunner_139" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="pwiz-sharp/tcbuild.sh" />
          <param name="command.parameters" value="--i-agree-to-the-vendor-licenses --automated --require-vendor-support" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1839" name="teamcity.agent.jvm.os.name" value="Linux" />
    </requirements>
    <build-triggers>
      <build-trigger id="retryBuildTrigger" type="retryBuildTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enqueueTimeout" value="0" />
          <param name="moveToTheQueueTop" value="true" />
          <param name="reRunBuildWithTheSameRevisions" value="true" />
          <param name="retryAttempts" value="2" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_504" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="buildTestCount" />
          <param name="metricThreshold" value="50" />
          <param name="metricUnits" value="metricUnitsDefault" />
          <param name="moreOrLess" value="less" />
          <param name="withBuildAnchor" value="true" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_446" type="BuildFailureOnMessage">
        <parameters>
          <param name="buildFailureOnMessage.conditionType" value="contains" />
          <param name="buildFailureOnMessage.messagePattern" value="The spot instance is scheduled for termination" />
          <param name="buildFailureOnMessage.outputText" value="AWS terminated the spot instance early. Retrigger the build manually from TeamCity." />
          <param name="buildFailureOnMessage.reverse" value="false" />
          <param name="buildFailureOnMessage.stopBuildOnFailure" value="true" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_457" type="BuildFailureOnMessage">
        <parameters>
          <param name="buildFailureOnMessage.conditionType" value="contains" />
          <param name="buildFailureOnMessage.messagePattern" value="terminated due to StackOverflowException" />
          <param name="buildFailureOnMessage.outputText" value="Build terminated due to stack overflow in Skyline tests (see build log)." />
          <param name="buildFailureOnMessage.reverse" value="false" />
          <param name="buildFailureOnMessage.stopBuildOnFailure" value="true" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_544" type="BuildFailureOnMessage">
        <parameters>
          <param name="buildFailureOnMessage.conditionType" value="contains" />
          <param name="buildFailureOnMessage.messagePattern" value="...failed" />
          <param name="buildFailureOnMessage.reportOnlyFirstMatch" value="false" />
          <param name="buildFailureOnMessage.reverse" value="false" />
        </parameters>
      </extension>
    </build-extensions>
    <cleanup>
      <policy type="days" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="120" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

