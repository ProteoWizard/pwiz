<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="32579704-66d7-4833-8d86-90a2790f1ac9" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Core Linux x86_64</name>
  <description />
  <settings>
    <inherits>
      <ref id="ProteoWizard_LinuxCore" />
      <ref id="ProteoWizard_GitHubReportingConfig" />
    </inherits>
    <build-runners order="simpleRunner, RUNNER_simpleRunner_122, RUNNER_336, RUNNER_80">
      <runner id="simpleRunner" name="" type="simpleRunner">
        <parameters>
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="script.content" value="ls -l libraries" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_80" name="" type="ProteoWizard_UploadArtifactMetadataToSourceForge">
        <parameters>
          <param name="WINDOWS_CHECKOUT_DIR" value="Z:\pwiz" />
          <param name="WINDOWS_SKYLINE_RELEASE_CHECKOUT_DIR" value="C:\skyline_release" />
          <param name="env.NUMBER_OF_CORES" value="%teamcity.agent.hardware.cpuCount%" />
          <param name="env.PYTHON_HOME" value="C:\Python38" />
          <param name="system.artifact.paths" value="build-linux-x86_64/*.tar.bz2,build-linux-x86_64/VERSION" />
          <param name="teamcity.activeBuildBranch.age.hours" value="0" />
          <param name="teamcity.activeVcsBranch.age.days" value="3" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <build-triggers>
      <build-trigger id="retryBuildTrigger" type="retryBuildTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enqueueTimeout" value="0" />
          <param name="moveToTheQueueTop" value="true" />
          <param name="reRunBuildWithTheSameRevisions" value="true" />
          <param name="retryAttempts" value="2" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_504" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="buildTestCount" />
          <param name="metricThreshold" value="50" />
          <param name="metricUnits" value="metricUnitsDefault" />
          <param name="moreOrLess" value="less" />
          <param name="withBuildAnchor" value="true" />
        </parameters>
      </extension>
    </build-extensions>
  </settings>
</build-type>

