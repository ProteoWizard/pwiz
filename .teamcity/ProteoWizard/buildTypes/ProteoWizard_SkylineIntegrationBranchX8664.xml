<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="91d4f771-6553-40ae-8651-83f29a0a1806" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Skyline Integration Branch x86_64</name>
  <description>YOU MUST REBUILD AFTER VCS CHANGE!!!!  Builds 64 bit on changes to branch declared in Skyline Integration VCS</description>
  <settings ref="ProteoWizard_WindowsBase">
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="artifactRules" value="pwiz_tools/Skyline/TestResults/*.trx&#xA;pwiz_tools/Skyline/bin/staging/Release/SkylineNightly.zip&#xA;pwiz_tools/Skyline/bin/staging/Release/SkylineTester.zip&#xA;pwiz_tools/Skyline/bin/staging/Release/BiblioSpec.zip" />
      <option name="branchFilter" value="+:&lt;default&gt;" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="skyline_integration" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="120" />
    </options>
    <disabled-settings>
      <setting-ref ref="RUNNER_2140" />
    </disabled-settings>
    <parameters>
      <param name="env.address_model_property" value="address-model=64" />
      <param name="env.address_model_short" value="64" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_2140" name="Skyline and Topograph (1)" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="scripts/misc/tcbuild.bat" />
          <param name="command.parameters" value="pwiz_tools\Skyline pwiz_tools\Topograph --i-agree-to-the-vendor-licenses -j%env.NUMBER_OF_CORES% %env.toolset_property% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property% --without-compassxtract --teamcity-test-decoration" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="simpleRunner" name="New build step" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="pwiz_tools/Skyline/tcbuild.bat" />
          <param name="command.parameters" value="--i-agree-to-the-vendor-licenses --automated --require-vendor-support" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubSkylineIntegrationOnly" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1530" name="teamcity.agent.jvm.os.name" value="Windows" />
      <not-exists id="RQ_1532" name="VS2013" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="61" />
          <param name="quietPeriodMode" value="USE_CUSTOM" />
          <param name="triggerRules"><![CDATA[+:.
-:README.md
-:.travis.yml
-:appveyor.yml
-:.gitignore
-:.teamcity]]></param>
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_690" type="teamcity.github.status">
        <parameters>
          <param name="github_report_on" value="on start and finish" />
          <param name="guthub_authentication_type" value="token" />
          <param name="guthub_context" value="teamcity - %system.teamcity.buildConfName%" />
          <param name="guthub_guest" value="true" />
          <param name="guthub_host" value="https://api.github.com" />
          <param name="guthub_owner" value="ProteoWizard" />
          <param name="guthub_repo" value="pwiz" />
          <param name="secure:github_access_token" value="credentialsJSON:b249da28-7099-46bd-b976-5efcef2bbca2" />
        </parameters>
      </extension>
    </build-extensions>
    <cleanup>
      <policy type="builds" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepBuilds.count" value="3" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

