    </build-extensions>
    <artifact-dependencies>
      <dependency id="ARTIFACT_DEPENDENCY_2279" sourceBuildTypeId="bt83" cleanDestination="true">
        <revisionRule name="sameChain" revision="latest.sameChain" />
        <artifact sourcePath="ProteoWizard-WithVendorSdks-Setup*.exe =&gt; container/artifacts" />
