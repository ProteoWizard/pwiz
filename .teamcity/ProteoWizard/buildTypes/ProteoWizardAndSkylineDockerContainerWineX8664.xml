<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="ca663540-2c69-43d8-bcb5-88902d82385c" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>ProteoWizard and Skyline Docker container (Wine x86_64)</name>
  <description>Builds the container from the latest binary snapshots</description>
  <settings ref="ProteoWizard_GitHubReportingConfig">
    <options>
      <option name="artifactRules" value="**/*.log =&gt; logs.tar.gz&#xA;**/*.diff =&gt; diffs.tar.gz&#xA;pwiz-skyline-i-agree-to-the-vendor-licenses.*&#xA;/tmp/pwiz-skyline-i-agree-to-the-vendor-licenses.*&#xA;%system.teamcity.build.tempDir%/*pwiz-skyline-i-agree-to-the-vendor-licenses_x64*.simg&#xA;-:**/duration.log&#xA;-:**/AcqData&#xA;-:**/method.log&#xA;-:TestRunner*.log&#xA;-:pwiz_tools/Skyline/**/*.log" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number.ProteoWizard_PwizGithubMasterWithPRs%)" />
      <option name="checkoutDirectory" value="pwiz-container" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="60" />
      <option name="showDependenciesChanges" value="true" />
    </options>
    <disabled-settings>
      <setting-ref ref="RUNNER_385" />
      <setting-ref ref="TRIGGER_1024" />
    </disabled-settings>
    <parameters>
      <param name="env.MSPARSER_HOME" value="" />
      <param name="env.address_model_property" value="" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.variant_property" value="release" />
      <param name="system.build.vcs.number" value="%system.build.vcs.number.ProteoWizard_GithubContainer%" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_2155" name="Build container" type="simpleRunner">
        <parameters>
          <param name="script.content"><![CDATA[rm -f *.tar.bz2 *.zip *.exe
mv artifacts/* .
if ls ProteoWizard-*Setup-*.exe >/dev/null 2>&1; then
  PB=proteowizard/wine:stable11.0-x64;  RB=proteowizard/wine:stable11.0-x64
else
  PB=ubuntu:20.04;  RB=proteowizard/wine-dotnet:winestaging10.6-net4.8-x64
fi
# The .NET msconvert prints no version, so the image carries the one in the installer's name
# (ProteoWizard-WithVendorSdks-Setup-<version>.exe, the installer the Dockerfile installs) as a
# label, which the Publish Docker image config tags the image with.
LABEL_ARGS=""
SETUP=$(ls ProteoWizard-WithVendorSdks-Setup-*.exe 2>/dev/null | head -1)
if [ -n "$SETUP" ]; then
  VERSION=$(basename "$SETUP" .exe | sed -e 's/^ProteoWizard-WithVendorSdks-Setup-//')
  echo "ProteoWizard version: $VERSION"
  LABEL_ARGS="--label org.opencontainers.image.version=$VERSION"
fi
/usr/bin/docker system prune --all --force --volumes
df -h
/usr/bin/docker build --build-arg PAYLOAD_BASE=$PB --build-arg RUNTIME_BASE=$RB $LABEL_ARGS -t chambm/pwiz-skyline-i-agree-to-the-vendor-licenses:x64 .]]></param>
          <param name="teamcity.build.workingDir" value="container" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_337" name="Run ProteoWizard tests" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="scripts/container/tctest.sh" />
          <param name="command.parameters" value="--install-deps --teamcity" />
          <param name="plugin.docker.imageId" value="chambm/pwiz-skyline-i-agree-to-the-vendor-licenses:x64" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="plugin.docker.run.parameters" value="--rm -e WINEDEBUG=-all" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_334" name="Run Skyline tests" type="simpleRunner">
        <parameters>
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="plugin.docker.imageId" value="chambm/pwiz-skyline-i-agree-to-the-vendor-licenses:x64" />
          <param name="script.content"><![CDATA[TC=##teamcity

# The three skipped method tests each shell out to a vendor method builder
# (BuildThermoMethod / BuildShimadzuMethod / BuildAgilentMethod), which drives a
# vendor method-authoring SDK. Those are not expected to work under Wine and
# nobody needs them to, so they are excluded rather than left failing - a
# permanently red test is indistinguishable from a new one.

echo " ${TC}[testSuiteStarted name='Skyline Test.dll']"
wine TestRunner test=Test.dll skip=CodeInspection,TestCommandLineExportThermoMethod language=en loop=1 runsmallmoleculeversions=1 teamcitytestdecoration=1
echo " ${TC}[testSuiteFinished name='Skyline Test.dll']"

echo " ${TC}[testSuiteStarted name='Skyline TestData.dll']"
wine TestRunner test=TestData.dll skip=TestInstallFromZip,ConsoleMethodTest,TestExportMethodShimadzu language=en loop=1 runsmallmoleculeversions=1 teamcitytestdecoration=1
echo " ${TC}[testSuiteFinished name='Skyline TestData.dll']"

# args previously passed to docker run
# -v %teamcity.build.checkoutDir%/pwiz_tools/Skyline:/wineprefix64/drive_c/pwiz/skyline/TestZipFiles]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_343" name="Save Docker tarball" type="simpleRunner">
        <parameters>
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="script.content" value="/usr/bin/docker save chambm/pwiz-skyline-i-agree-to-the-vendor-licenses:x64 | pigz -c &gt; /tmp/pwiz-skyline-i-agree-to-the-vendor-licenses.tbz2" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_385" name="Convert Docker image to Singularity" type="simpleRunner">
        <parameters>
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="plugin.docker.imageId" value="singularityware/docker2singularity:v2.5" />
          <param name="plugin.docker.imagePlatform" value="linux" />
          <param name="plugin.docker.run.parameters" value="-v /var/run/docker.sock:/var/run/docker.sock -v %system.teamcity.build.tempDir%:/output --privileged -t" />
          <param name="script.content"><![CDATA[rm -f /%system.teamcity.build.tempDir%/*.simg
docker-entrypoint.sh /docker2singularity.sh chambm/pwiz-skyline-i-agree-to-the-vendor-licenses:x64]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_75" name="" type="ProteoWizard_UploadArtifactMetadataToSourceForge">
        <parameters>
          <param name="WINDOWS_CHECKOUT_DIR" value="Z:\pwiz" />
          <param name="WINDOWS_SKYLINE_RELEASE_CHECKOUT_DIR" value="C:\skyline_release" />
          <param name="env.NUMBER_OF_CORES" value="%teamcity.agent.hardware.cpuCount%" />
          <param name="env.PYTHON_HOME" value="C:\Python38" />
          <param name="system.artifact.paths" value="pwiz-skyline-i-agree-to-the-vendor-licenses.*,/tmp/pwiz-skyline-i-agree-to-the-vendor-licenses.*,%system.teamcity.build.tempDir%/*pwiz-skyline-i-agree-to-the-vendor-licenses_x64*.simg" />
          <param name="teamcity.activeBuildBranch.age.hours" value="0" />
          <param name="teamcity.activeVcsBranch.age.days" value="3" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_GithubContainer">
        <checkout-rule rule="+:. =&gt; container" />
      </vcs-entry-ref>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_471" name="teamcity.agent.jvm.os.name" value="Linux" />
      <does-not-equal id="RQ_473" name="teamcity.agent.jvm.os.arch" value="i386" />
      <exists id="RQ_2033" name="docker.version" />
    </requirements>
    <build-triggers>
      <build-trigger id="TRIGGER_1024" type="schedulingTrigger">
        <parameters>
          <param name="branchFilter" value="-:Skyline/skyline_*" />
          <param name="cronExpression_dm" value="*" />
          <param name="cronExpression_dw" value="?" />
          <param name="cronExpression_hour" value="*" />
          <param name="cronExpression_min" value="0" />
          <param name="cronExpression_month" value="*" />
          <param name="cronExpression_sec" value="0" />
