<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="ba530f23-b700-491d-921d-9b99ea1bf983" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Core Windows x86_64 - Publish monthly release</name>
  <description>Pins last month's last successful Core Windows x86_64 build as its monthly release and publishes the download page's monthly release metadata</description>
  <settings>
    <options>
      <option name="artifactRules" value="releases_out =&gt; releases" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="15" />
    </options>
    <parameters>
      <param name="release.latest" value="" spec="checkbox checkedValue='--latest' uncheckedValue='' label='Release the latest build now' description='Release the newest successful build, e.g. between months; it stays a permanent release, and its month still gets its regular release when it ends' display='normal'" />
      <param name="release.month" value="" spec="text label='Release month' description='YYYY-MM whose last build to release; leave empty for the previous month' validationMode='any' display='normal'" />
    </parameters>
    <build-runners order="pip_upgrade_certifi, Publish_monthly_release, Dry_run_monthly_release, Upload_monthly_release_metadata">
      <runner id="pip_upgrade_certifi" name="" type="pip_upgrade_certifi">
        <parameters>
          <param name="env.PYTHON_HOME" value="C:\Python38" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="Publish_monthly_release" name="Pin the monthly release and write its metadata" type="simpleRunner">
        <conditions>
          <equals name="teamcity.build.branch.is_default" value="true" />
          <does-not-equal name="env.BUILD_IS_PERSONAL" value="true" />
        </conditions>
        <parameters>
          <param name="command.executable" value="%python3.executable%" />
          <param name="command.parameters" value="scripts/misc/publish_monthly_release.py --output-dir releases_out --teamcity-user pwiz-commit --teamcity-password %TeamCityAuthToken% --month=%release.month% %release.latest%" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="Dry_run_monthly_release" name="Dry run with guest access (not the default branch)" type="simpleRunner">
        <conditions>
          <does-not-equal name="teamcity.build.branch.is_default" value="true" />
        </conditions>
        <parameters>
          <param name="command.executable" value="%python3.executable%" />
          <param name="command.parameters" value="scripts/misc/publish_monthly_release.py --dry-run --output-dir releases_out --month=%release.month% %release.latest%" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="Upload_monthly_release_metadata" name="Upload monthly release metadata to SourceForge" type="ssh-deploy-runner">
        <conditions>
          <equals name="teamcity.build.branch.is_default" value="true" />
          <does-not-equal name="env.BUILD_IS_PERSONAL" value="true" />
        </conditions>
        <parameters>
          <param name="jetbrains.buildServer.deployer.sourcePath" value="releases_out/*" />
          <param name="jetbrains.buildServer.deployer.ssh.transport" value="jetbrains.buildServer.deployer.ssh.transport.sftp" />
          <param name="jetbrains.buildServer.deployer.targetUrl" value="web.sf.net:/home/project-web/proteowizard/htdocs/releases" />
          <param name="jetbrains.buildServer.deployer.username" value="chambm" />
          <param name="jetbrains.buildServer.sshexec.authMethod" value="UPLOADED_KEY" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcitySshKey" value="chambm@sourceforge.net-ed25519" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs">
        <checkout-rule rule="+:scripts/misc" />
      </vcs-entry-ref>
    </vcs-settings>
    <requirements>
      <contains id="RQ_publish_monthly_windows" name="teamcity.agent.jvm.os.name" value="Windows" />
    </requirements>
    <build-triggers>
      <build-trigger id="monthlyTrigger" type="schedulingTrigger">
        <parameters>
          <param name="branchFilter" value="+:&lt;default&gt;" />
          <param name="cronExpression_dm" value="1" />
          <param name="cronExpression_dw" value="?" />
          <param name="cronExpression_hour" value="6" />
          <param name="cronExpression_min" value="0" />
          <param name="cronExpression_month" value="*" />
          <param name="cronExpression_sec" value="0" />
          <param name="cronExpression_year" value="*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="promoteWatchedBuild" value="true" />
          <param name="revisionRule" value="lastFinished" />
          <param name="revisionRuleBuildBranch" value="&lt;default&gt;" />
          <param name="schedulingPolicy" value="cron" />
          <param name="timezone" value="SERVER" />
          <param name="triggerBuildWithPendingChangesOnly" value="false" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <cleanup>
      <policy type="days" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="365" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>
