<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="968b21e0-c901-457a-b410-02f41976103b" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Skyline Release Branch  x86_64</name>
  <description>YOU MUST REBUILD AFTER VCS CHANGE!! Builds 64 bit on changes to branch declared in Skyline Release VCS</description>
  <settings>
    <inherits>
      <ref id="ProteoWizard_GitHubReportingConfig" />
      <ref id="ProteoWizard_WindowsBase" />
      <ref id="ProteoWizard_RemoteAccountTestParameters" />
    </inherits>
    <options>
      <option name="artifactRules" value="build-nt-x86/*.tar.bz2&#xA;pwiz_tools/Skyline/TestResults/*.trx&#xA;pwiz_tools/Topograph/TestResults/*.trx&#xA;pwiz_tools/Skyline/bin/x64/Release/SkylineTester.zip&#xA;pwiz_tools/Skyline/bin/x64/Release/SkylineNightly.zip" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="%WINDOWS_SKYLINE_RELEASE_CHECKOUT_DIR%" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="120" />
    </options>
    <disabled-settings>
      <setting-ref ref="BUILD_EXT_10" />
      <setting-ref ref="RQ_1273" />
      <setting-ref ref="RQ_1274" />
      <setting-ref ref="vcsTrigger" />
    </disabled-settings>
    <parameters>
      <param name="env.address_model_property" value="address-model=64" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_98" name="Create PrositConfig file" type="MRPP_CreateTextFile">
        <parameters>
          <param name="content" value="%prositconfig_production_xml%" />
          <param name="system.dest.file" value="pwiz_tools/Skyline/Model/Prosit/Config/PrositConfig_production.xml" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_16" name="Build and run unit tests" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="%teamcity.build.checkoutDir%/scripts/misc/tcbuild.bat" />
          <param name="command.parameters" value="pwiz_tools\Skyline//Test pwiz_tools\Skyline//TestData pwiz_tools\Skyline//Skyline.passed pwiz_tools\Skyline//SkylineTester.zip --i-agree-to-the-vendor-licenses -j%env.NUMBER_OF_CORES% %env.toolset_property% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property% --without-compassxtract --teamcity-test-decoration --automated --official" />
          <param name="teamcity.build.workingDir" value="build-nt-x86" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_99" name="Run TestFunctional tests" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="%teamcity.build.checkoutDir%/quickbuild.bat" />
          <param name="command.parameters" value="pwiz_tools\Skyline//TestFunctional --abbreviate-paths --verbose-test --incremental --i-agree-to-the-vendor-licenses -j%env.NUMBER_OF_CORES% %env.toolset_property% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property% --without-compassxtract --teamcity-test-decoration --automated" />
          <param name="script.content" value="pwiz_tools\Skyline\bin\x64\Release\TestRunner.exe buildcheck=1 test=TestFunctional.dll offscreen=0 pass0=on teamcitytestdecoration=1 runsmallmoleculeversions=on" />
          <param name="teamcity.build.workingDir" value="build-nt-x86" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
      <runner id="RUNNER_20" name="Run Test and TestData tests with pass0=on (no vendor readers, French language)" type="simpleRunner">
        <parameters>
          <param name="script.content" value="%teamcity.build.checkoutDir%\pwiz_tools\Skyline\bin\x64\Release\TestRunner.exe buildcheck=1 test=Test.dll,TestData.dll offscreen=0 pass0=on pass2=off teamcitytestdecoration=1 runsmallmoleculeversions=on" />
          <param name="teamcity.build.workingDir" value="build-nt-x86" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="RUNNER_23" name="Run TestData pass1 subset" type="simpleRunner">
        <parameters>
          <param name="script.content" value="%teamcity.build.checkoutDir%\pwiz_tools\Skyline\bin\x64\Release\TestRunner.exe log=TestPass1Subset.log buildcheck=1 pass1=on pass2=off test=TestInstrumentInfo,TestQcTraces,TestTicChromatogram,TestDiaSearchFixedWindows offscreen=0 teamcitytestdecoration=1 runsmallmoleculeversions=on" />
          <param name="teamcity.build.workingDir" value="build-nt-x86" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubSkylineReleaseOnlyWithPRs1" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1272" name="teamcity.agent.jvm.os.name" value="Windows" />
      <exists id="RQ_1273" name="VS2013" />
      <exists id="RQ_1274" name="env.VS120COMNTOOLS" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:&lt;default&gt;" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="60" />
          <param name="quietPeriodMode" value="USE_DEFAULT" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <build-extensions>
      <extension id="BUILD_EXT_18" type="BuildFailureOnMetric">
        <parameters>
          <param name="anchorBuild" value="lastSuccessful" />
          <param name="metricKey" value="InspectionStatsW" />
          <param name="metricThreshold" value="400" />
          <param name="metricUnits" value="metricUnitsDefault" />
          <param name="moreOrLess" value="more" />
          <param name="withBuildAnchor" value="false" />
        </parameters>
      </extension>
      <extension id="BUILD_EXT_10" type="pullRequests">
        <parameters>
          <param name="authenticationType" value="token" />
          <param name="filterAuthorRole" value="MEMBER" />
          <param name="filterTargetBranch" value="Skyline/skyline_20_2" />
          <param name="providerType" value="github" />
          <param name="secure:accessToken" value="credentialsJSON:68dc8891-7a87-42e1-984d-b04598196aa7" />
          <param name="vcsRootId" value="ProteoWizard_PwizGithubSkylineReleaseOnly" />
        </parameters>
      </extension>
    </build-extensions>
    <cleanup>
      <policy type="builds" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepBuilds.count" value="3" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

