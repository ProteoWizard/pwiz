<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="4b946d44-d5a6-4824-b510-35c2f3e08633" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>zSmart build trigger</name>
  <description>Avoids redundant builds without breaking required GitHub PR checks</description>
  <settings>
    <options>
      <option name="allowPersonalBuildTriggering" value="false" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="c:\teamcity\zSmartTrigger" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="excludeDefaultBranchChanges" value="true" />
      <option name="executionTimeoutMin" value="45" />
      <option name="showDependenciesChanges" value="true" />
    </options>
    <disabled-settings>
      <setting-ref ref="RQ_212" />
      <setting-ref ref="RQ_213" />
      <setting-ref ref="RUNNER_93" />
    </disabled-settings>
    <parameters>
      <param name="env.address_model_property" value="address-model=64" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.toolset_property" value="toolset=msvc-14.1" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_93" name="Deepen git clone" type="simpleRunner">
        <parameters>
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="script.content"><![CDATA[git fetch --unshallow
git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
git fetch origin]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="pip_upgrade_certifi" name="" type="pip_upgrade_certifi">
        <parameters>
          <param name="env.PYTHON_HOME" value="C:\Python38" />
          <param name="plugin.docker.imageId" value="" />
          <param name="plugin.docker.imagePlatform" value="" />
          <param name="plugin.docker.run.parameters" value="" />
          <param name="teamcity.step.mode" value="default" />
          <param name="teamcity.step.phase" value="" />
        </parameters>
      </runner>
      <runner id="RUNNER_203" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="%python3.executable%" />
          <param name="command.parameters" value="scripts/misc/smartBuildTrigger.py scripts/misc/vcs_trigger_and_paths_config.py %teamcity.build.branch% %GitHubAuthToken% pwiz-commit %TeamCityAuthToken%" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubForSmartTrigger2" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_211" name="teamcity.agent.jvm.os.name" value="Windows" />
      <exists id="RQ_212" name="env.VS120COMNTOOLS" />
      <not-exists id="RQ_213" name="VS2013" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriodMode" value="DO_NOT_USE" />
        </parameters>
      </build-trigger>
    </build-triggers>
    <cleanup>
      <policy type="days" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="365" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</build-type>

