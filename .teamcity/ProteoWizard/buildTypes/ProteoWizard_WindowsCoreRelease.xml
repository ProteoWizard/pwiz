<?xml version="1.0" encoding="UTF-8"?>
<template xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="d94d54f2-270b-4738-a41c-ee0c149b60ce" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Windows core release</name>
  <settings>
    <options>
      <option name="allowExternalStatus" value="true" />
      <option name="artifactRules" value="build-nt-x86/*.msi&#xA;build-nt-x86/*.tar.bz2&#xA;build-nt-x86/VERSION&#xA;**/*.blib.observed" />
      <option name="buildNumberPattern" value="%build.counter% (%system.build.vcs.number%)" />
      <option name="checkoutDirectory" value="%WINDOWS_CHECKOUT_DIR%" />
      <option name="checkoutMode" value="ON_AGENT" />
      <option name="executionTimeoutMin" value="60" />
    </options>
    <disabled-settings>
      <setting-ref ref="vcsTrigger" />
    </disabled-settings>
    <parameters>
      <param name="env.address_model_property" value="address-model=64" />
      <param name="env.architecture_property" value="" />
      <param name="env.link_property" value="" />
      <param name="env.variant_property" value="release" />
    </parameters>
    <build-runners>
      <runner id="RUNNER_simpleRunner_139" name="" type="simpleRunner">
        <parameters>
          <param name="command.executable" value="scripts/misc/tcbuild.bat" />
          <param name="command.parameters" value="--i-agree-to-the-vendor-licenses --automated --require-vendor-support pwiz-bin.tar.bz2 pwiz pwiz_aux pwiz_tools/commandline pwiz_tools/examples pwiz_tools/sld pwiz_tools/SeeMS pwiz_tools/MSConvertGUI pwiz_tools/BiblioSpec scripts/wix -j%env.NUMBER_OF_CORES% %env.toolset_property% %env.address_model_property% %env.architecture_property% %env.variant_property% %env.link_property%" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.downloadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.uploadSpecSource" value="Job configuration" />
          <param name="org.jfrog.artifactory.selectedDeployableServer.useSpecs" value="false" />
          <param name="teamcity.step.mode" value="default" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="ProteoWizard_PwizGithubMasterWithPRs" />
    </vcs-settings>
    <requirements>
      <contains id="RQ_1839" name="teamcity.agent.jvm.os.name" value="Windows" />
    </requirements>
    <build-triggers>
      <build-trigger id="vcsTrigger" type="vcsTrigger">
        <parameters>
          <param name="branchFilter"><![CDATA[+:*
-:Skyline/skyline_*]]></param>
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="61" />
          <param name="quietPeriodMode" value="USE_CUSTOM" />
          <param name="triggerRules"><![CDATA[+:.
-:README.md
-:.travis.yml
-:appveyor.yml
-:.gitignore]]></param>
        </parameters>
      </build-trigger>
    </build-triggers>
    <cleanup>
      <policy type="days" cleanup-level="ARTIFACTS">
        <parameters>
          <param name="artifactPatterns" value="+:**/*" />
          <param name="keepDays.count" value="120" />
        </parameters>
      </policy>
    </cleanup>
  </settings>
</template>

