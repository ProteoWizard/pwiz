<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The seam to pwiz-sharp: the only Quasar project that references pwiz types, so the
         logic projects stay pure. -->
    <RootNamespace>pwiz.Quasar.IO</RootNamespace>
    <AssemblyName>Quasar.IO</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quasar.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quasar.Features\Quasar.Features.csproj" />
    <!-- Known precursors from Osprey's blib (OspreyRunReader) are Quasar.Core types. -->
    <ProjectReference Include="..\Quasar.Core\Quasar.Core.csproj" />
    <!-- pwiz-sharp's chemistry (isotope tables, elements): Pwiz.Util.Chemistry. -->
    <ProjectReference Include="..\..\..\pwiz\utility\Util.csproj" />
    <!-- Spectra from raw files and mzML through ProteowizardWrapper, read the way Osprey reads
         them (Osprey.IO carries the reference and its vendor-format rules). -->
    <ProjectReference Include="..\..\Osprey\Osprey.IO\Osprey.IO.csproj" />
  </ItemGroup>

</Project>
