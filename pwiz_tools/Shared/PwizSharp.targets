<Project>

  <!-- PwizSharp.targets - the ONE place where the Skyline tree reaches into pwiz-sharp.

       Every project under pwiz_tools that needs ProteoWizard (the managed pwiz-sharp port)
       imports this file instead of naming pwiz-sharp projects itself. A consumer opts into the
       blocks it needs by setting properties BEFORE the Import:

         PwizSharpReferenceLibraries=true
             The ProteoWizard data layer: core libraries + every vendor reader. This is what
             ProteowizardWrapper compiles against.
         PwizSharpDeployTools=true
             The command-line tools Skyline shells out to (BlibBuild, BlibFilter, msconvert,
             bullseye-sharp), built first and copied into the consumer's output directory.
         PwizSharpReferencePrmScheduling=true
             The managed Bruker timsTOF PRM scheduler (replacement for the legacy C++/CLI
             pwiz.CLI.Bruker.PrmScheduling assembly).

       Today every block is expressed as ProjectReferences into $(PwizSharpRoot) (defined in
       pwiz_tools\Directory.Build.props). Keeping them in one file is what lets the next step -
       consuming a locally built ProteoWizard NuGet package instead of the projects - happen
       without touching the consumers again. See TODO-20260907_pwiz_local_nuget.md in
       pwiz-ai/todos. -->

  <!-- Vendor-license opt-in, read the SAME two ways pwiz-sharp reads it, because the consumers
       compile against types pwiz-sharp drops in a no-vendor build.

       There are two ways to agree, and they do NOT have the same reach:
         * -p:IAgreeToVendorLicenses=true (build.bat / build.ps1 / Build-Skyline -VendorLicenses)
           is a GLOBAL property, so it arrives here on its own.
         * pwiz-sharp\i-agree-to-the-vendor-licenses.bat writes pwiz-sharp\Directory.Build.user.props,
           which only pwiz-sharp\Directory.Build.props imports - projects outside
           pwiz-sharp\ never see it.
       Without this import the second route would leave pwiz-sharp compiling the lockmass
       refiners while the wrapper believed they were absent, silently dropping Waters
       lockmass correction from a build that fully supports it. -->
  <Import Project="$(PwizSharpRoot)Directory.Build.user.props"
          Condition="Exists('$(PwizSharpRoot)Directory.Build.user.props')" />

  <!-- ======================================================================
       Libraries: the ProteoWizard data layer.
       ====================================================================== -->

  <!-- Mirrors Analysis.csproj: when the licenses are not agreed, pwiz-sharp Compile-Removes
       SpectrumList_LockmassRefiner / ChromatogramListLockmassRefiner and defines
       NO_VENDOR_SUPPORT. A consumer of those types has to be told the same thing or it fails
       to compile in exactly the configuration CI and the shipped zips build. Not for net472,
       which reaches pwiz through pwiz.CLI, where the refiners are always present. -->
  <PropertyGroup Condition="'$(PwizSharpReferenceLibraries)' == 'true' AND '$(TargetFramework)' != 'net472' AND '$(IAgreeToVendorLicenses)' != 'true'">
    <DefineConstants>$(DefineConstants);NO_VENDOR_SUPPORT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PwizSharpReferenceLibraries)' == 'true' AND '$(TargetFramework)' != 'net472'">
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\MsData\MsData.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Analysis\Analysis.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Common\Common.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Util\Util.csproj" />
    <!-- Vendor readers: pwiz-sharp's ReaderList.Default only has mzML/mzMLb/mzXML/MGF/MSn/BTDX.
         Reference the vendor projects so their Reader_X classes can be added to
         ReaderList.AdditionalReaders at MsDataFileImpl static-ctor time (see
         MsDataFileImpl.cs). Without these, Thermo/Waters/Sciex/etc. files fail
         with "No registered reader recognized the file". -->
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Thermo\Thermo.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Waters\Waters.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Sciex\Sciex.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Shimadzu\Shimadzu.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Agilent\Agilent.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Bruker\Bruker.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\UIMF\UIMF.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\UNIFI\UNIFI.csproj" />
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Mobilion\Mobilion.csproj" />
  </ItemGroup>

  <!-- ======================================================================
       Bruker timsTOF PRM scheduler.
       ====================================================================== -->

  <!-- Managed replacement for the legacy C++/CLI pwiz.CLI.Bruker.PrmScheduling assembly.
       P/Invokes prmscheduler.dll shipped inside pwiz. Not for net472, which keeps the old
       C++/CLI reference. -->
  <ItemGroup Condition="'$(PwizSharpReferencePrmScheduling)' == 'true' AND '$(TargetFramework)' != 'net472'">
    <ProjectReference Include="$(PwizSharpRoot)pwiz\src\Vendor\Bruker.PrmScheduling\Bruker.PrmScheduling.csproj" />
  </ItemGroup>

  <!-- ======================================================================
       Tools: executables Skyline shells out to, deployed next to Skyline.
       ====================================================================== -->

  <!-- Each tool is referenced as a project (ReferenceOutputAssembly=false) so it builds first,
       and its output is then deployed with a Content include. Content items propagate through
       ProjectReference by default, so the tools also reach any project that references Skyline
       (the test assemblies). The Exists() guards are there because a Content glob over a bin
       directory that does not exist yet captures nothing on a clean build; the first build
       builds the tool, the second deploys it. -->

  <!-- BiblioSpec CLI tools (BlibBuild, BlibFilter). Skyline shells out to these via
       ProcessStartInfo expecting them to sit next to Skyline in the bin dir. -->
  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true'">
    <ProjectReference Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\BlibBuild.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <ProjectReference Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibFilter\BlibFilter.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true'">
    <Content Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0\**\*"
             Condition="Exists('$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibFilter\bin\$(Configuration)\net10.0\**\*"
             Condition="Exists('$(PwizSharpRoot)Tools\BiblioSpec\src\BlibFilter\bin\$(Configuration)\net10.0')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- BlibBuild reads Mascot .dat results through the native MascotShim.dll wrapper and its
       msparser.dll dependency, emitted under BlibBuild's runtimes\win-x64\native\. The wildcard
       Content above does not deploy files whose Link lands under runtimes\...\ into consuming bins
       (they collide with RID-specific native-asset handling), so the mascot reader was missing at
       run time. Deploy the mascot natives flat next to BlibBuild.exe - as legacy Skyline shipped
       msparser.dll - so DllImport("MascotShim") and its msparser dependency resolve from the
       executable's own directory. -->
  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true' AND Exists('$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0\runtimes\win-x64\native')">
    <Content Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0\runtimes\win-x64\native\MascotShim.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MascotShim.dll</Link>
      <Visible>false</Visible>
    </Content>
    <!-- BiblioSpec.csproj emits msparserD.dll in Debug and msparser.dll otherwise
         (Debug links msparserD.lib), so the name has to track $(Configuration) here
         too. Copying the Release name unconditionally made every Debug build after
         the first one fail MSB3030 - the first build passes only because the native
         directory does not exist yet when this ItemGroup condition is evaluated. -->
    <Content Condition="'$(Configuration)' == 'Debug'" Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0\runtimes\win-x64\native\msparserD.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>msparserD.dll</Link>
      <Visible>false</Visible>
    </Content>
    <Content Condition="'$(Configuration)' != 'Debug'" Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0\runtimes\win-x64\native\msparser.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>msparser.dll</Link>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(PwizSharpRoot)Tools\BiblioSpec\src\BlibBuild\bin\$(Configuration)\net10.0\runtimes\win-x64\native\msparser-config\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>msparser-config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- msconvert (managed pwiz-sharp port). Skyline shells out to msconvert for DIA-Umpire and
       EncyclopeDIA demultiplexing conversions, expecting msconvert.exe next to Skyline in the bin
       dir (resolved via PathEx.ResolveBundledExe). Not for net472, which gets the native
       msconvert from the Jam toolchain. -->
  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true' AND '$(TargetFramework)' != 'net472'">
    <ProjectReference Include="$(PwizSharpRoot)Tools\Commandline\MsConvert\src\MsConvert.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true' AND '$(TargetFramework)' != 'net472' AND Exists('$(PwizSharpRoot)Tools\Commandline\MsConvert\src\bin\$(Configuration)\net10.0')">
    <Content Include="$(PwizSharpRoot)Tools\Commandline\MsConvert\src\bin\$(Configuration)\net10.0\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- BullseyeSharp (managed pwiz-sharp port; its AssemblyName is "bullseye-sharp", so it emits
       bullseye-sharp.exe). Skyline's Hardklor feature-detection pipeline shells out to it to match
       MS1 features against MS2 scans, expecting bullseye-sharp.exe next to Skyline in the bin dir
       (resolved via PathEx.ResolveBundledExe). Not for net472, which gets the legacy
       BullseyeSharp.exe from pwiz_tools\Skyline\BullseyeSharp\BullseyeSharp.csproj via the Jam
       toolchain. -->
  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true' AND '$(TargetFramework)' != 'net472'">
    <ProjectReference Include="$(PwizSharpRoot)Tools\BullseyeSharp\src\BullseyeSharp.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(PwizSharpDeployTools)' == 'true' AND '$(TargetFramework)' != 'net472' AND Exists('$(PwizSharpRoot)Tools\BullseyeSharp\src\bin\$(Configuration)\net10.0')">
    <Content Include="$(PwizSharpRoot)Tools\BullseyeSharp\src\bin\$(Configuration)\net10.0\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
