<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendor-license opt-in, read the SAME two ways pwiz-sharp reads it, because the net8
       target compiles against types pwiz-sharp drops in a no-vendor build.

       There are two ways to agree, and they do NOT have the same reach:
         * -p:IAgreeToVendorLicenses=true (build.bat / build.ps1 / Build-Skyline -VendorLicenses)
           is a GLOBAL property, so it arrives here on its own.
         * pwiz-sharp\i-agree-to-the-vendor-licenses.bat writes pwiz-sharp\Directory.Build.user.props,
           which only pwiz-sharp\Directory.Build.props imports - projects outside
           pwiz-sharp\ never see it.
       Without this import the second route would leave pwiz-sharp compiling the lockmass
       refiners while this project believed they were absent, silently dropping Waters
       lockmass correction from a build that fully supports it. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\pwiz-sharp\Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\pwiz-sharp\Directory.Build.user.props')" />

  <!-- ProteowizardWrapper — the Phase-2 chokepoint. Multi-target net472 (legacy
       pwiz.CLI bindings) + PLAIN net8.0 (pwiz-sharp managed port).

       The net8 target is deliberately net8.0 and NOT net8.0-windows: it was only
       -windows because pwiz.CommonUtil set UseWindowsForms, and CommonUtil has now
       been split (its WinForms types live in CommonBaseUI). A plain net8.0 wrapper is
       what lets Osprey consume it on Linux instead of reading pwiz-sharp directly.

       Same MsDataFileImpl class name and public surface in both targets. The
       net472 legacy MsDataFileImpl.cs is excluded on net8.0 - instead
       we pull the parallel implementation from the
       ../ProteowizardWrapper.PwizSharp/ sandbox directory, which has the same
       public API but uses pwiz-sharp internally. Eventually the sandbox file
       gets merged in-place but for now this lets Skyline link against pwiz-sharp
       on net8 with zero call-site changes. -->
  <PropertyGroup>
    <ProjectGuid>{DACEE7D5-5A6A-4001-9602-FAB1A9A2DE59}</ProjectGuid>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.ProteowizardWrapper</RootNamespace>
    <AssemblyName>ProteowizardWrapper</AssemblyName>
    <Company>University of Washington</Company>
    <Product>ProteowizardWrapper</Product>
    <AssemblyTitle>ProteowizardWrapper</AssemblyTitle>
    <Copyright>Copyright © University of Washington 2026</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- Legacy pwiz.CLI bindings + vendor SDK assemblies. Same set Skyline.sln
         resolves today. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Security" />
    <Reference Include="MassSpecDataReader">
      <HintPath>..\Lib\MassSpec\MassSpecDataReader.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="SCIEX.Apis.Data.v1">
      <HintPath>..\Lib\SCIEX.Apis.Data.v1.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.Data">
      <HintPath>..\Lib\Thermo\ThermoFisher.CommonCore.Data.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="pwiz_data_cli" Condition="'$(PwizCliAssembly)' == ''">
      <HintPath>..\Lib\pwiz_data_cli.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="$(PwizCliAssembly)" Condition="'$(PwizCliAssembly)' != ''">
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- Mirrors Analysis.csproj: when the licenses are not agreed, pwiz-sharp Compile-Removes
       SpectrumList_LockmassRefiner / ChromatogramListLockmassRefiner and defines
       NO_VENDOR_SUPPORT. This project consumes those types, so it has to be told the same
       thing or it fails to compile in exactly the configuration CI and the shipped zips
       build. net8 only - the net472 target reaches pwiz through pwiz.CLI, where the
       refiners are always present. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' AND '$(IAgreeToVendorLicenses)' != 'true'">
    <DefineConstants>$(DefineConstants);NO_VENDOR_SUPPORT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- On net8 the data layer comes from pwiz-sharp. No pwiz.CLI, no
         C++/CLI bindings. -->
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\MsData\MsData.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Analysis\Analysis.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Common\Common.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Util\Util.csproj" />
    <!-- Vendor readers: pwiz-sharp's ReaderList.Default only has mzML/mzMLb/mzXML/MGF/MSn/BTDX.
         Reference the vendor projects so their Reader_X classes can be added to
         ReaderList.AdditionalReaders at MsDataFileImpl static-ctor time (see
         MsDataFileImpl.cs). Without these, Thermo/Waters/Sciex/etc. files fail
         with "No registered reader recognized the file". -->
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Thermo\Thermo.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Waters\Waters.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Sciex\Sciex.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Shimadzu\Shimadzu.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Agilent\Agilent.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Bruker\Bruker.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\UIMF\UIMF.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\UNIFI\UNIFI.csproj" />
    <ProjectReference Include="..\..\..\pwiz-sharp\pwiz\src\Vendor\Mobilion\Mobilion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommonUtil\CommonUtil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- On net8 swap legacy MsDataFileImpl + siblings for the pwiz-sharp-backed
         sandbox implementation (same public surface, different internals). -->
    <Compile Remove="MsDataFileImpl.cs" Condition="'$(TargetFramework)' == 'net8.0'" />
    <Compile Remove="MsDataFileInfo.cs" Condition="'$(TargetFramework)' == 'net8.0'" />
    <Compile Remove="IterationListenerToMonitor.cs" Condition="'$(TargetFramework)' == 'net8.0'" />
    <!-- DiaUmpire.cs now compiles on net8 too: the pwiz.CLI dependency was only two
         enum-discriminator values, replaced with plain literals. The wrapper's job
         (write msconvert-compatible .params + parse DIA-Umpire userParams back out of mzML)
         doesn't touch the engine - msconvert runs DIA-Umpire out of process. -->
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileImpl.cs" Condition="'$(TargetFramework)' == 'net8.0'" Link="MsDataFileImpl.cs" />
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileImpl.Vendors.cs" Condition="'$(TargetFramework)' == 'net8.0'" Link="MsDataFileImpl.Vendors.cs" />
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileInfo.cs" Condition="'$(TargetFramework)' == 'net8.0'" Link="MsDataFileInfo.cs" />
  </ItemGroup>

</Project>
