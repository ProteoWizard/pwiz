<Project Sdk="Microsoft.NET.Sdk">

  <!-- ProteowizardWrapper — the Phase-2 chokepoint. Multi-target net472 (legacy
       pwiz.CLI bindings) + PLAIN net10.0 (pwiz-sharp managed port).

       The net8 target is deliberately net10.0 and NOT net10.0-windows: it was only
       -windows because pwiz.CommonUtil set UseWindowsForms, and CommonUtil has now
       been split (its WinForms types live in CommonBaseUI). A plain net10.0 wrapper is
       what lets Osprey consume it on Linux instead of reading pwiz-sharp directly.

       Same MsDataFileImpl class name and public surface in both targets. The
       net472 legacy MsDataFileImpl.cs is excluded on net10.0 - instead
       we pull the parallel implementation from the
       ../ProteowizardWrapper.PwizSharp/ sandbox directory, which has the same
       public API but uses pwiz-sharp internally. Eventually the sandbox file
       gets merged in-place but for now this lets Skyline link against pwiz-sharp
       on net8 with zero call-site changes. -->
  <PropertyGroup>
    <ProjectGuid>{DACEE7D5-5A6A-4001-9602-FAB1A9A2DE59}</ProjectGuid>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.ProteowizardWrapper</RootNamespace>
    <AssemblyName>ProteowizardWrapper</AssemblyName>
    <Company>University of Washington</Company>
    <Product>ProteowizardWrapper</Product>
    <AssemblyTitle>ProteowizardWrapper</AssemblyTitle>
    <Copyright>Copyright © University of Washington 2026</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>


  <!-- On net8 the data layer comes from pwiz-sharp: no pwiz.CLI, no C++/CLI bindings.
       Every pwiz-sharp project this wrapper compiles against (core libraries + vendor
       readers), the vendor-license opt-in and the matching NO_VENDOR_SUPPORT define all
       live in Shared\PwizSharp.targets, the one file in the tree that names pwiz-sharp
       projects. -->
  <PropertyGroup>
    <PwizSharpReferenceLibraries>true</PwizSharpReferenceLibraries>
  </PropertyGroup>
  <Import Project="..\PwizSharp.targets" />

  <ItemGroup>
    <ProjectReference Include="..\CommonUtil\CommonUtil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- On net8 swap legacy MsDataFileImpl + siblings for the pwiz-sharp-backed
         sandbox implementation (same public surface, different internals). -->
    <Compile Remove="MsDataFileImpl.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <Compile Remove="MsDataFileInfo.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <Compile Remove="IterationListenerToMonitor.cs" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- DiaUmpire.cs now compiles on net8 too: the pwiz.CLI dependency was only two
         enum-discriminator values, replaced with plain literals. The wrapper's job
         (write msconvert-compatible .params + parse DIA-Umpire userParams back out of mzML)
         doesn't touch the engine - msconvert runs DIA-Umpire out of process. -->
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileImpl.cs" Condition="'$(TargetFramework)' == 'net10.0'" Link="MsDataFileImpl.cs" />
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileImpl.Vendors.cs" Condition="'$(TargetFramework)' == 'net10.0'" Link="MsDataFileImpl.Vendors.cs" />
    <Compile Include="..\ProteowizardWrapper.PwizSharp\MsDataFileInfo.cs" Condition="'$(TargetFramework)' == 'net10.0'" Link="MsDataFileInfo.cs" />
  </ItemGroup>

</Project>
