<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common — multi-target net472 + net10.0-windows. The biggest mid-tier
       Shared library. Depends on CommonUtil + MSGraph + ZedGraph (all already
       multi-targeted) and a handful of HintPath legacy DLLs that have NuGet
       equivalents on net8. -->
  <PropertyGroup>
    <ProjectGuid>{A5527BE9-4A62-458F-AE47-F0F9204A5CF9}</ProjectGuid>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.Common</RootNamespace>
    <AssemblyName>pwiz.Common</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win;win-x64;win-x86</RuntimeIdentifiers>
    <!-- net472 keeps using Properties/AssemblyInfo.cs (legacy parity); net8 lets the
         SDK generate the company/product/title/copyright attributes from project
         metadata. AssemblyInfo.cs gates those lines with #if NET472. -->
    <Company>University of Washington</Company>
    <Product>Common</Product>
    <AssemblyTitle>Common</AssemblyTitle>
    <Copyright>Copyright © University of Washington 2009-2011</Copyright>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- Old NETStandard.Library 1.6 (transitive via NHibernate→Antlr3.Runtime) requests
         old versions of System.* meta-packages that net8 supersedes at runtime; the
         NU1605 "downgrade" is benign here. Suppress only on net8 — net472 doesn't hit
         the issue because it has its own BCL story. -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 was already a PackageReference in the legacy csproj; safe on both targets. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.864.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommonUtil\CommonUtil.csproj" />
    <ProjectReference Include="..\CommonBaseUI\CommonBaseUI.csproj" />
    <ProjectReference Include="..\MSGraph\MSGraph.csproj" />
    <ProjectReference Include="..\zedgraph\ZedGraph.csproj" />
  </ItemGroup>

  <!-- DocumentationGenerator.GetStyleSheetHtml() loads this stylesheet via
       assembly.GetManifestResourceStream(typeof(DocumentationGenerator), "DocumentationGenerator.css")
       and returns an empty stylesheet if it isn't embedded. SDK default globs don't embed .css. -->
  <ItemGroup>
    <EmbeddedResource Include="DataBinding\Documentation\DocumentationGenerator.css" />
  </ItemGroup>


  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- net8 replacements. NHibernate 5.5+ supports net6+. log4net 2.x is net6+
         compatible. MathNet, Sprache, System.Data.SQLite.Core all multi-target
         to net6+. -->
    <!-- NHibernate 5.5's transitive Antlr3.Runtime 3.5.1 pulls in NETStandard.Library 1.6
         which forces NU1605 package downgrades on net8. Use the modern 5.5.x line that
         drops the Antlr3.Runtime dep, OR upgrade Antlr to a net-compatible version. -->
    <PackageReference Include="NHibernate" Version="5.5.2" />
    <PackageReference Include="Iesi.Collections" Version="4.0.5" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <!-- MathNet 5.0 removed Control.LinearAlgebraProvider and the internal
         Resources class. 4.15.x preserves the legacy API surface Skyline uses
         while still targeting net6+. -->
    <PackageReference Include="MathNet.Numerics" Version="4.15.0" />
    <PackageReference Include="Sprache" Version="2.3.1" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <!-- slicevfs.dll, the native SQLite extension SqliteSliceVfs loads to open a database stored
       uncompressed inside a .zip in place. It has to be native: the System.Data.SQLite interop
       does not export sqlite3_vfs_register, so a VFS cannot be registered from managed code.
       Compiled here by Visual Studio MSBuild (the .NET SDK's MSBuild cannot import the C++
       targets), as Mobilion.csproj does MobilionShim. A host that cannot compile it (not Windows)
       takes it from $(PwizPrebuiltNativeShimDir), the artifact of tcbuild-native-shims.bat.
       Content flows to every project that references this one, so it lands next to
       pwiz.Common.dll, where SqliteSliceVfs looks for it. -->
  <PropertyGroup>
    <SliceVfsDir>$(MSBuildThisFileDirectory)SliceVfs</SliceVfsDir>
    <SliceVfsPlatform>x64</SliceVfsPlatform>
    <SliceVfsPlatform Condition="'$(Platform)' == 'x86'">Win32</SliceVfsPlatform>
    <SliceVfsDll>$(SliceVfsDir)\bin\$(SliceVfsPlatform)\$(Configuration)\slicevfs.dll</SliceVfsDll>
    <_SliceVfsPrebuilt Condition="'$(_PwizPrebuiltNativeShimDir)' != ''">true</_SliceVfsPrebuilt>
    <_SliceVfsCompiled Condition="'$(_SliceVfsPrebuilt)' != 'true' AND '$(OS)' == 'Windows_NT'">true</_SliceVfsCompiled>
  </PropertyGroup>

  <Target Name="LocateSliceVfsMSBuild"
          Condition="'$(_SliceVfsCompiled)' == 'true' AND '$(VsMSBuildExe)' == ''">
    <!-- vswhere.exe is always under Program Files (x86); see Mobilion.csproj -->
    <Exec Command="&quot;C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe&quot; -latest -prerelease -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find MSBuild\**\Bin\MSBuild.exe"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsMSBuildExe" />
    </Exec>
    <Error Condition="'$(VsMSBuildExe)' == ''"
           Text="Could not locate Visual Studio MSBuild.exe via vswhere; needed to build slicevfs.vcxproj. Install Visual Studio 2022+ with the Desktop C++ workload." />
  </Target>

  <!-- -nodeReuse:false: a VS MSBuild node left running can mis-evaluate a later .NET SDK build
       (see tcbuild-native-shims.bat). -->
  <Target Name="BuildSliceVfs"
          Condition="'$(_SliceVfsCompiled)' == 'true'"
          DependsOnTargets="LocateSliceVfsMSBuild"
          BeforeTargets="ResolveAssemblyReferences;ResolveReferences;AssignTargetPaths"
          Inputs="$(SliceVfsDir)\slicevfs.c;$(SliceVfsDir)\sqlite3.h;$(SliceVfsDir)\sqlite3ext.h;$(SliceVfsDir)\slicevfs.vcxproj"
          Outputs="$(SliceVfsDll)">
    <Exec Command="&quot;$(VsMSBuildExe)&quot; &quot;$(SliceVfsDir)\slicevfs.vcxproj&quot; -p:Configuration=$(Configuration) -p:Platform=$(SliceVfsPlatform) -nologo -v:minimal -nodeReuse:false" />
  </Target>

  <Target Name="WarnSliceVfsMissing"
          Condition="'$(_SliceVfsPrebuilt)' != 'true' AND '$(_SliceVfsCompiled)' != 'true'"
          BeforeTargets="Build">
    <Warning Text="slicevfs.dll cannot be compiled on $(OS) and no -p:PwizPrebuiltNativeShimDir was given, so the build output cannot read a .blib or .protdb in place from a .sky.zip." />
  </Target>

  <ItemGroup Condition="'$(_SliceVfsCompiled)' == 'true'">
    <Content Include="$(SliceVfsDll)">
      <Link>slicevfs.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(_SliceVfsPrebuilt)' == 'true'">
    <Content Include="$(_PwizPrebuiltNativeShimDir)slicevfs.dll">
      <Link>slicevfs.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
