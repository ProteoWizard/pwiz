<Project Sdk="Microsoft.NET.Sdk">

  <!-- PanoramaClient - lightweight web client wrapping the Panorama / LabKey REST API.
       PLAIN net10.0 (no -windows, no WinForms): SkylineCore references it, and SkylineCore
       must run on Linux. The folder and file pickers are PanoramaClientUI. -->
  <PropertyGroup>
    <ProjectGuid>{BF849CF8-25D7-4619-B001-9ED8E3771C44}</ProjectGuid>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.PanoramaClient</RootNamespace>
    <AssemblyName>PanoramaClient</AssemblyName>
    <Company>University of Washington</Company>
    <Product>PanoramaClient</Product>
    <AssemblyTitle>PanoramaClient</AssemblyTitle>
    <Copyright>Copyright © University of Washington 2026</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommonUtil\CommonUtil.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
