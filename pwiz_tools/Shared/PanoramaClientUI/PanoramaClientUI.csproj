<Project Sdk="Microsoft.NET.Sdk">

  <!-- PanoramaClientUI - the WinForms half of PanoramaClient: the Panorama folder browser and
       the file and directory pickers built on it. Split out so that PanoramaClient itself is
       plain net10.0 and can be referenced by SkylineCore, which must run on Linux.

       The forms keep the pwiz.PanoramaClient namespace, so moving them cost no call sites.
       Their images and strings are pwiz.PanoramaClientUI.Properties.Resources: a second
       public pwiz.PanoramaClient.Properties.Resources would be ambiguous to every project
       that references both assemblies. -->
  <PropertyGroup>
    <ProjectGuid>{667207E7-8D98-4D68-8DA9-27406B36A788}</ProjectGuid>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.PanoramaClientUI</RootNamespace>
    <AssemblyName>PanoramaClientUI</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>University of Washington</Company>
    <Product>PanoramaClient</Product>
    <AssemblyTitle>PanoramaClientUI</AssemblyTitle>
    <Copyright>Copyright (c) University of Washington 2026</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PanoramaClient\PanoramaClient.csproj" />
    <ProjectReference Include="..\CommonUtil\CommonUtil.csproj" />
    <ProjectReference Include="..\CommonBaseUI\CommonBaseUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
