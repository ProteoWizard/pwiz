<Project>

  <!-- Side-by-side wiff2 dlls, for every project whose output loads the Sciex wiff2 plugin
       (Pwiz.Vendor.Sciex.Wiff2.dll): msconvert, MsDiff, SeeMS, MSConvertGUI and Sciex.Tests.
       Import this file in each; without the wiff2\ folder every .wiff2 fails to open.

       Skyline reads .wiff2 in-process too but does not import this file: it gets wiff2\ by
       deploying msconvert's whole output tree (DeployOutput="true" on its MsConvert.csproj
       reference, Skyline.csproj _DeployBundledToolOutputs), which also carries the folder to the
       test assemblies that reference Skyline. If that deployment changes, Skyline needs this
       import. BullseyeSharp references Sciex.csproj but not the wiff2 plugin, so it has no .wiff2
       support to stage for.

       The wiff2 SDK is loaded into a custom AssemblyLoadContext (Wiff2LoadContext) that pulls
       bundled Clearcore2/OFX/Unity dlls from SCIEX.Apis.Data.v1's SmartAssembly resources, plus a
       dedicated copy of SQLite 1.0.109 (no SEE license probe) and its matching native interop, all
       from the wiff2\ subfolder beside the executable. The on-disk signed-PKT Clearcore2 dlls
       remain in the default ALC for the legacy .wiff path (AnalystDataProvider was compiled against
       those identities). The two ALCs coexist because their resolved assemblies have different
       PublicKeyTokens, so there's no identity collision. When the folder is missing,
       Wiff2LoadContext falls back to the default-ALC System.Data.SQLite (1.0.119), whose native
       SQLite.Interop.dll has no sqlite3_config entry point, and the SDK fails on the first read.

       Gated on $(NativeVendorsAvailable), not $(IAgreeToVendorLicenses): the files staged below
       come from Sciex.csproj's extraction, which only runs on Windows. The Linux CI passes
       IAgreeToVendorLicenses=true, so the weaker gate would run this target there and fail the
       build on the missing SQLite.Interop.dll.

       Needs VendorNativeCrt.targets imported too (every importer already imports it for its own
       output root), which supplies @(VendorNativeCrtFile). Importing it here as well would be a
       duplicate import, so the target fails instead if the items are missing. -->
  <Target Name="StageWiff2NativeAssemblies" AfterTargets="Build" Condition="'$(NativeVendorsAvailable)' == 'true'">
    <Error Condition="'@(VendorNativeCrtFile)' == ''"
           Text="SciexWiff2Staging.targets needs VendorNativeCrt.targets imported as well; without it the wiff2\ folder gets no VC++ runtime and SQLite.Interop.dll cannot load." />
    <PropertyGroup>
      <!-- System.Data.SQLite.dll (1.0.109) and Unity.Abstractions.dll (Cecil-patched) are
           committed at vendor-archives/Sciex/. Both originate from the SmartAssembly bundle inside
           SCIEX.Apis.Data.v1.dll; we keep on-disk copies because the wiff2 SDK is hard-bound to
           those exact assembly identities. See src/Vendor/Sciex/wiff2-on-net8-investigation.md
           for provenance. -->
      <_SciexWiff2DepsDir>$(PwizVendorArchivesPath)\Sciex</_SciexWiff2DepsDir>
      <!-- SQLite.Interop.dll: extracted by Sciex.csproj's ExtractSciexAssemblies from
           vendor_api_ABI.7z's vendor_api\ABI\x64\ subfolder and flattened into
           vendor-assemblies/Sciex/. -->
      <_SciexAssembliesDir>$(PwizVendorAssembliesPath)\Sciex</_SciexAssembliesDir>
      <!-- MSBuild appends the trailing slash to OutputPath inside the project, which cannot
           touch a GLOBAL property, so `dotnet build -o <dir>` leaves it slash-less and
           "$(OutputPath)wiff2" resolves to the SIBLING directory "<dir>wiff2". The plugin
           directory then does not exist beside the executable, Wiff2LoadContext falls back to
           the default-ALC SQLite/Unity, and EVERY .wiff2 fails to open. That silently produced
           4 bogus conversion failures in the C++-vs-C# parity sweep. -->
      <_Wiff2OutDir>$([MSBuild]::EnsureTrailingSlash('$(OutputPath)'))wiff2</_Wiff2OutDir>
    </PropertyGroup>
    <MakeDir Directories="$(_Wiff2OutDir)" />
    <Copy SourceFiles="$(_SciexWiff2DepsDir)\System.Data.SQLite.dll" DestinationFiles="$(_Wiff2OutDir)\System.Data.SQLite.dll" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(_SciexAssembliesDir)\SQLite.Interop.dll" DestinationFiles="$(_Wiff2OutDir)\SQLite.Interop.dll" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(_SciexWiff2DepsDir)\Unity.Abstractions.dll" DestinationFiles="$(_Wiff2OutDir)\Unity.Abstractions.dll" OverwriteReadOnlyFiles="true" />
    <!-- The CRT again, beside SQLite.Interop.dll. The copy in the output root does not serve a
         plugin subfolder: loading a native DLL by full path uses LOAD_WITH_ALTERED_SEARCH_PATH,
         which searches the DLL's own directory in place of the application directory. See
         VendorNativeCrt.targets. -->
    <Copy SourceFiles="@(VendorNativeCrtFile)" DestinationFolder="$(_Wiff2OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
