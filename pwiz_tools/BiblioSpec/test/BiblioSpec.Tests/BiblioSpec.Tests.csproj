<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BiblioSpec\BiblioSpec.csproj" />
  </ItemGroup>

  <!-- The 4 CLI tools (BlibBuild / BlibFilter / BlibSearch / BlibToMs2) are
       process-exec'd by ExecuteBlib.cs from their own bin folders. Referenced only so they
       build before this project (ReferenceOutputAssembly=false: their assemblies, with their
       entry points, are not referenced or copied here). Without this, a build of this project
       alone - build.bat's no-vendor test step, or a local dotnet test - left the tools unbuilt
       and their tests Inconclusive. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BlibBuild\BlibBuild.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\BlibFilter\BlibFilter.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\BlibSearch\BlibSearch.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\BlibToMs2\BlibToMs2.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The MascotShim smoke tests reference internal types from BiblioSpec
       (MascotShimInterop, MascotResult) that are themselves gated on
       <MascotSupport>. Mirror the gate here so the test file doesn't fail
       to compile when MascotSupport=false; the default matches BiblioSpec.csproj's. -->
  <PropertyGroup>
    <MascotSupport Condition="'$(MascotSupport)' == '' AND ('$(IAgreeToVendorLicenses)' == 'true' OR '$(PwizPrebuiltNativeShimDir)' != '')">true</MascotSupport>
    <MascotSupport Condition="'$(MascotSupport)' == ''">false</MascotSupport>
  </PropertyGroup>
  <ItemGroup Condition="'$(MascotSupport)' != 'true'">
    <Compile Remove="MascotShimSmokeTests.cs" />
  </ItemGroup>

  <!-- BuildTests gates its .dat (Mascot) and .wiff (Sciex) cases on these (MASCOT_SUPPORT as
       BiblioSpec.csproj defines it, NO_VENDOR_SUPPORT as Analysis.Tests does), so a build
       without Mascot or the vendor readers compiles those cases out. -->
  <PropertyGroup Condition="'$(MascotSupport)' == 'true'">
    <DefineConstants>$(DefineConstants);MASCOT_SUPPORT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NativeVendorsAvailable)' != 'true'">
    <DefineConstants>$(DefineConstants);NO_VENDOR_SUPPORT</DefineConstants>
  </PropertyGroup>

  <!-- The golden-file tests read fixtures from pwiz_tools/BiblioSpec/tests/inputs/, which is
       gitignored and populated from inputs.tar.bz2 beside it. Without this the archive is never
       unpacked and 69 of the 142 tests fail on missing inputs - which is exactly the state this
       suite was in, unnoticed, because it was also absent from build.bat's test list.

       Reuses the vendor-fixture target purely for its extraction semantics; the archive is not
       vendor data. Those semantics matter here: it extracts with bsdtar -xkf (the skip-old-files
       flag off-Windows), i.e. it never overwrites a file that already exists. ~100 files in that
       directory are force-added to git despite the ignore rule and are the authoritative,
       newer copies; the archive is the older cpp-era set and carries stale versions of three of
       them. Overwriting would silently regress the data (verified: forcing the archive's
       waters-mobility.final_fragment.csv over the tracked one turns Mse_Mobility red). -->
  <PropertyGroup>
    <VendorTestArchive>$(PwizToolsRoot)\BiblioSpec\tests\inputs.tar.bz2</VendorTestArchive>
    <VendorTestDataParent>$(PwizToolsRoot)\BiblioSpec\tests</VendorTestDataParent>
  </PropertyGroup>
  <Import Project="..\..\..\..\build\ExtractTestData.targets" />

</Project>
