<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>pwiz.Osprey.Test</RootNamespace>
    <AssemblyName>Osprey.Test</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Parquet.Net" Version="4.25.0" />
    <!-- 1.0.119 to match pwiz-sharp, whose Bruker and UIMF readers pull the same
         package (a lower version here is an NU1605 downgrade error). -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!--
      Parquet.Net writes use IronCompress + ZstdSharp for Zstd compression,
      which needs the native nironcompress.dll deployed alongside the test
      assembly. Exe projects (e.g. Osprey) get this for free because the
      SDK infers a RuntimeIdentifier and unwraps runtimes/win-x64/native/*;
      library/test projects don't. net8.0 resolves the native dep via
      deps.json automatically, so IronCompress is declared here only to pin
      the version the Parquet.Net write path resolves.
    -->
    <PackageReference Include="IronCompress" Version="1.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osprey.Core\Osprey.Core.csproj" />
    <ProjectReference Include="..\Osprey.ML\Osprey.ML.csproj" />
    <ProjectReference Include="..\Osprey.IO\Osprey.IO.csproj" />
    <ProjectReference Include="..\Osprey.Chromatography\Osprey.Chromatography.csproj" />
    <ProjectReference Include="..\Osprey.Scoring\Osprey.Scoring.csproj" />
    <ProjectReference Include="..\Osprey.FDR\Osprey.FDR.csproj" />
    <ProjectReference Include="..\Osprey\Osprey.csproj" />
  </ItemGroup>

</Project>
