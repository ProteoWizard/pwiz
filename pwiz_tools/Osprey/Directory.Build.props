<Project>

  <PropertyGroup>
    <!-- net8.0 only. The net472 target existed so Osprey could reach
         pwiz_data_cli, which has no .NET 8 build (issue #4496); pwiz-sharp
         supplies a managed net8.0 data layer instead, so there is nothing left
         for a .NET Framework target to offer. Plain net8.0, not
         net8.0-windows: Osprey must run on Linux/WSL with no Wine container.

         NOTE: this branch now sits on the CommonUtil/CommonBaseUI split, which
         made ProteowizardWrapper plain net8.0. Reading pwiz-sharp DIRECTLY was
         forced by the wrapper being net8.0-windows; that constraint is gone, so
         going back through the wrapper - and inheriting the six MsDataFileImpl
         semantics this branch reproduces by hand - is now the open question. -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- SDK-style csproj defaults to AnyCPU, but Osprey.sln uses x64
         configurations, which VS 2026 flags as "unknown project
         configuration mappings" unless the projects advertise x64.
         Declare both so:
           * the x64 sln configs map cleanly (VS stops warning, CI keeps
             working with /p:Platform=x64),
           * the .NET 8.0 target can still be built AnyCPU on other hosts
             (e.g. Arm64 macOS/Linux) without touching any csproj. -->
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>University of Washington</Company>
    <Copyright>Copyright (c) University of Washington 2026</Copyright>
    <!-- Osprey follows the Skyline version scheme YEAR.ORDINAL.BRANCH.DOY
         (see pwiz_tools/Skyline/Jamfile.jam). <Version> is the source of truth
         for standalone `dotnet build`; the Boost build and build.ps1 override it
         with the day-of-year-stamped value via /p:Version. The DOY is 0 here as
         the "not stamped by a dated build" sentinel. AssemblyVersion/FileVersion
         are intentionally left to derive from Version; pinning them explicitly
         would block the /p:Version override from reaching
         Assembly.GetName().Version, which OspreyVersion.Current reads as the
         logical osprey version. -->
    <Version>26.1.1.0</Version>
    <!-- Directory.Build.targets stamps AssemblyInformationalVersion itself as
         "<numeric>-<githash>[-dirty]"; keep the SDK from appending its own
         "+<sha>" source-revision metadata so OspreyVersion parses one clean form. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Server GC is driven by runtimeconfig.json auto-generated from these
         MSBuild properties. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
