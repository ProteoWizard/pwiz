<Project>

  <PropertyGroup>
    <!-- The net472 target existed so Osprey could reach pwiz_data_cli, which has no
         .NET Core build (issue #4496); pwiz-sharp supplies a managed data layer
         instead, so there is nothing left for a .NET Framework target to offer.
         Plain net10.0, not net10.0-windows: Osprey must run on Linux/WSL with no
         Wine container, which is also why ProteowizardWrapper had to become plain
         (the CommonUtil/CommonBaseUI split this branch sits on). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- SDK-style csproj defaults to AnyCPU, but Osprey.sln uses x64
         configurations, which VS 2026 flags as "unknown project
         configuration mappings" unless the projects advertise x64.
         Declare both so:
           * the x64 sln configs map cleanly (VS stops warning, CI keeps
             working with /p:Platform=x64),
           * the .NET 8.0 target can still be built AnyCPU on other hosts
             (e.g. Arm64 macOS/Linux) without touching any csproj. -->
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>University of Washington</Company>
    <Copyright>Copyright (c) University of Washington 2026</Copyright>
    <!-- Osprey follows the Skyline version scheme YEAR.ORDINAL.BRANCH.DOY
         (see pwiz_tools/Skyline/Jamfile.jam). This is the placeholder; on every
         build path the StampOspreyInformationalVersion target in
         Directory.Build.targets replaces it with the day-of-year-stamped value
         from version.ps1. The DOY is 0 here as the "not stamped by a dated build"
         sentinel. The scripts do not pass /p:Version: a global property would also
         stamp the libraries Osprey shares with Skyline. AssemblyVersion/FileVersion
         are intentionally left to derive from Version; pinning them explicitly
         would block the stamped Version from reaching Assembly.GetName().Version,
         which OspreyVersion.Current reads as the logical osprey version. -->
    <Version>26.1.1.0</Version>
    <!-- Directory.Build.targets stamps AssemblyInformationalVersion itself as
         "<numeric>-<githash>[-dirty]"; keep the SDK from appending its own
         "+<sha>" source-revision metadata so OspreyVersion parses one clean form. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Server GC is driven by runtimeconfig.json auto-generated from these
         MSBuild properties. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- CarafeSharp's libtorch backend selection: Osprey.exe predicts spectral libraries through
       CarafeSharp.Tasks, so the executable and the test project carry the native runtime
       (UseLibTorch=true in their csproj; the item groups are in LibTorch.targets). The CPU
       build by default, as CarafeSharp's; Osprey keeps one output folder either way. -->
  <Import Project="$(MSBuildThisFileDirectory)..\CarafeSharp\LibTorch.props" />

</Project>
