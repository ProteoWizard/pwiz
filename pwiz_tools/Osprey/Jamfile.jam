import modules ;
if [ modules.peek : NT ]
{
    path-constant OSPREY_PATH : $(PWIZ_ROOT_PATH)/pwiz_tools/Osprey ;

    # ProteoWizard is always Osprey's reader now (issue #4497), but the VENDOR
    # SDKs behind it are licensed and their archives encrypted.  Pass the same
    # --i-agree-to-the-vendor-licenses flag every other vendor-API consumer in
    # this tree keys off (Skyline/Jamfile.jam:22) through to pwiz-sharp's own
    # gate, which extracts the SDKs and compiles the vendor readers for real.
    # Without it the vendor projects still build in NO_VENDOR_SUPPORT mode -
    # Identify() works, Read() throws - so `bjam Osprey` in a plain checkout
    # produces an Osprey that reads mzML and says something useful about a .raw.
    # No staging step and no wrapper build either way: pwiz-sharp is a managed
    # project reference, which is what let the old OspreyVendorReader property
    # and its pwiz_data_cli plumbing go.
    local vendor-licenses = false ;
    if --i-agree-to-the-vendor-licenses in [ modules.peek : ARGV ]
    {
        vendor-licenses = true ;
    }
    constant OSPREY_VENDOR_LICENSES : $(vendor-licenses) ;

    # Osprey uses SDK-style csproj that auto-generates AssemblyInfo from
    # the MSBuild properties in pwiz_tools/Osprey/Directory.Build.props
    # (Company, Copyright, Version, etc.).  Unlike SkylineBatch/AutoQC/SeeMS,
    # we do NOT generate Properties/AssemblyInfo.cs here - doing so would
    # conflict with the SDK auto-gen and break the standalone build.ps1 flow
    # with CS0579 duplicate-attribute errors.  Instead we override the
    # Directory.Build.props placeholder version via /p:Version at build time.

    # Osprey follows the Skyline version scheme YEAR.ORDINAL.BRANCH.DOY.
    # Compute it here (mirroring pwiz_tools/Skyline/Jamfile.jam) so official
    # builds stamp a dated version; the standalone build.ps1 computes the same
    # independently. The DOY is the day-of-year of the git commit date,
    # offset by 365 per year past OSPREY_YEAR. (For now these constants are
    # duplicated from Skyline; a future change may lift them to a shared Jamfile.)
    import generate-version ;
    constant OSPREY_YEAR : 26 ;
    constant OSPREY_ORDINAL : 1 ;
    constant OSPREY_BRANCH : 1 ;
    local osprey_git_date = [ SHELL "git log -1 --format=%cs HEAD" ] ;
    local osprey_ymd = [ MATCH "([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])" : $(osprey_git_date) ] ;
    if ! $(osprey_ymd)
    {
        local osprey_utc = [ modules.peek : JAMDATE ] ;
        osprey_ymd = [ MATCH "([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])" : $(osprey_utc) ] ;
    }
    local osprey_year2 = [ MATCH "[0-9][0-9]([0-9][0-9])" : $(osprey_ymd) ] ;
    local osprey_doy = [ CALC [ CALC [ CALC $(osprey_year2) - $(OSPREY_YEAR) ] * 365 ] + [ day_of_year $(osprey_ymd) ] ] ;
    constant OSPREY_VERSION : "$(OSPREY_YEAR).$(OSPREY_ORDINAL).$(OSPREY_BRANCH).$(osprey_doy)" ;

    rule do_osprey ( targets + : sources * : properties * )
    {
        MSVC_CURRENT_SETUP_SCRIPT on $(targets) = [ get-current-msvc-setup-script $(properties) ] ;
        CONFIGURATION on $(targets) = [ MATCH <variant>(.*) : $(properties) ] ;
        PLATFORM on $(targets) = [ MATCH <address-model>(.*) : $(properties) ] ;
        OSPREY_VERSION on $(targets) = $(OSPREY_VERSION) ;
    }

    actions do_osprey
    {
        $(MSVC_CURRENT_SETUP_SCRIPT)
        REM Set the vendor-license property ONLY when it was agreed to. /p: defines a
        REM GLOBAL MSBuild property, which outranks the <IAgreeToVendorLicenses>true</...>
        REM that pwiz-sharp's i-agree-to-the-vendor-licenses.bat writes into its gitignored
        REM Directory.Build.user.props - so passing the property as literal "false" would
        REM silently DISCARD a developer's standing opt-in and build every vendor reader in
        REM NO_VENDOR_SUPPORT mode, with nothing in the log saying so. pwiz-sharp's own
        REM build.bat only ever emits the true form, for the same reason.
        set OSPREY_VENDOR_PROP=
        IF "$(OSPREY_VENDOR_LICENSES)"=="true" set OSPREY_VENDOR_PROP=;IAgreeToVendorLicenses=true
        echo Building Osprey $(OSPREY_VERSION) in $(CONFIGURATION:L) configuration...
        msbuild $(OSPREY_PATH)/Osprey.sln /p:Configuration=$(CONFIGURATION);Platform=x64;Version=$(OSPREY_VERSION)%OSPREY_VENDOR_PROP% /nologo /verbosity:minimal
        IF ERRORLEVEL 1 exit %ERRORLEVEL%
    }

    rule do_osprey_test ( targets + : sources * : properties * )
    {
        MSVC_CURRENT_SETUP_SCRIPT on $(targets) = [ get-current-msvc-setup-script $(properties) ] ;
        CONFIGURATION on $(targets) = [ MATCH <variant>(.*) : $(properties) ] ;
    }

    actions do_osprey_test
    {
        $(MSVC_CURRENT_SETUP_SCRIPT)
        echo Unit testing Osprey in $(CONFIGURATION:L) configuration...
        vstest.console.exe $(OSPREY_PATH)\Osprey.Test\bin\x64\$(CONFIGURATION)\Osprey.Test.dll /Platform:x64
        set status=%ERRORLEVEL%
        exit %status%
    }

    # Full solution build. Explicit so it is opt-in (requested by name from
    # TeamCity or via `bjam Osprey`), not pulled into the default
    # Skyline build.
    make Osprey
        : # sources
        : # actions
            @do_osprey
        : # requirements
            <conditional>@no-express-requirement
            <conditional>@msvc-dotnet-requirement
        ;
    explicit Osprey ;

    # Unit-test target. Runs the Osprey.Test.dll MSTest suite via
    # vstest.console.exe after the full solution is built.
    make OspreyTest
        : # sources
        : # actions
            @do_osprey_test
        : # requirements
            <conditional>@no-express-requirement
            <conditional>@msvc-dotnet-requirement
            <dependency>Osprey
        ;
    explicit OspreyTest ;
}
