<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>pwiz.Osprey.Core</RootNamespace>
    <AssemblyName>Osprey.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Osprey.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\CommonUtil\CommonUtil.csproj" />
    <!-- UniMod, from the unimod.obo the rest of the repository reads (pwiz-sharp's
         Pwiz.Data.Common), so Osprey keeps no UniMod table of its own. Out of Osprey.sln,
         like CommonUtil; Osprey.IO already reached it through ProteowizardWrapper. -->
    <ProjectReference Include="..\..\..\pwiz\data\common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- User-facing text. The Designer is checked in; VS regenerates it when the .resx is saved. -->
    <Compile Update="OspreyCoreResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>OspreyCoreResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="OspreyCoreResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>OspreyCoreResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
