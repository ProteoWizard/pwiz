<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>pwiz.Osprey</RootNamespace>
    <AssemblyName>Osprey</AssemblyName>
    <!-- Declares longPathAware for native code in the process; see the file's comment. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The libtorch native runtime and CarafeSharp's pretrained models, for the one-command
         library build (the fasta option), which predicts the library in-process through
         CarafeSharp.Tasks. They load only when a library is predicted; a search of a given
         library never touches them. -->
    <UseLibTorch>true</UseLibTorch>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Osprey.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\CommonUtil\CommonUtil.csproj" />
    <ProjectReference Include="..\..\CarafeSharp\CarafeSharp.Contracts\CarafeSharp.Contracts.csproj" />
    <!-- CarafeSharp's command-line declarations (the library-build options Osprey presents as
         sections of its own help) and its library-prediction task. CarafeSharp.exe references
         nothing in Osprey: the dependency runs one way. -->
    <ProjectReference Include="..\..\CarafeSharp\CarafeSharp.Proteome\CarafeSharp.Proteome.csproj" />
    <ProjectReference Include="..\..\CarafeSharp\CarafeSharp.Tasks\CarafeSharp.Tasks.csproj" />
    <ProjectReference Include="..\Osprey.Core\Osprey.Core.csproj" />
    <ProjectReference Include="..\Osprey.Diagnostics\Osprey.Diagnostics.csproj" />
    <ProjectReference Include="..\Osprey.ML\Osprey.ML.csproj" />
    <ProjectReference Include="..\Osprey.IO\Osprey.IO.csproj" />
    <ProjectReference Include="..\Osprey.Chromatography\Osprey.Chromatography.csproj" />
    <ProjectReference Include="..\Osprey.Scoring\Osprey.Scoring.csproj" />
    <ProjectReference Include="..\Osprey.FDR\Osprey.FDR.csproj" />
    <ProjectReference Include="..\Osprey.Tasks\Osprey.Tasks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- User-facing text. The Designer is checked in; VS regenerates it when the .resx is saved. -->
    <Compile Update="OspreyResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>OspreyResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="OspreyResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>OspreyResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- User-facing text. The Designer is checked in; VS regenerates it when the .resx is saved. -->
    <Compile Update="OspreyCommandArgUsage.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>OspreyCommandArgUsage.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="OspreyCommandArgUsage.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>OspreyCommandArgUsage.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
