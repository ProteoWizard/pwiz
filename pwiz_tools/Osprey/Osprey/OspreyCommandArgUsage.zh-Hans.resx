    <comment>Needs Review:New resource</comment>
  </data>
  <data name="_experiment_fdr" xml:space="preserve">
    <value>实验水平 FDR 阈值（默认：0.01）</value>
    <comment>Needs Review:New resource</comment>
  </data>
  <data name="_fdr_level" xml:space="preserve">
    <value>FDR 水平（默认：{0}）</value>
