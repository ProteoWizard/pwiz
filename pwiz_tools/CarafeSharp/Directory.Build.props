<Project>

  <PropertyGroup>
    <!-- CarafeSharp builds and fine-tunes AlphaPeptDeep spectral libraries for Osprey. It
         reads no spectra itself (Osprey is the only raw-data reader), so it needs no
         pwiz-sharp reference and runs anywhere net10.0 and libtorch do. Plain net10.0, not
         net10.0-windows, for the same Linux/WSL reason as Osprey. This file also keeps
         pwiz_tools/Directory.Build.props (LangVersion 8.0 for the Skyline tree) from
         applying here, because MSBuild imports only the nearest Directory.Build.props. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- CarafeSharp.sln uses x64 configurations; advertise both so they map cleanly while
         an AnyCPU build still works on other hosts. -->
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>University of Washington</Company>
    <Copyright>Copyright (c) University of Washington 2026</Copyright>
    <!-- Skyline version scheme YEAR.ORDINAL.BRANCH.DOY, DOY 0 = not stamped by a dated build. -->
    <Version>26.1.1.0</Version>
    <!-- .NET 9+ defaults this to "all" (transitive), which fails restore on advisories in
         TorchSharp's transitive graph that CarafeSharp does not call. Audit direct references. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- NU1510: .NET 10 package pruning noise for PackageReferences the framework provides. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- libtorch backend selection (CarafeSharpTorch, the package versions, the host), shared with
       the Osprey tree, whose executable runs CarafeSharp's library prediction in-process. -->
  <Import Project="$(MSBuildThisFileDirectory)LibTorch.props" />

  <!-- Each backend builds into its own folders. Their native files have the same names and
       they restore different packages, so sharing bin/ and obj/ forced a clean rebuild and a
       4 GB recopy on every switch. The CPU build keeps the default folders, so IDE builds are
       unchanged. Both pairs are excluded from the default item globs: the SDK excludes only the
       current build's folders, and the other backend's generated sources would otherwise
       compile a second time. -->
  <PropertyGroup Condition="'$(CarafeSharpTorch)' == 'cuda'">
    <BaseOutputPath>bin-cuda\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj-cuda\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;bin-cuda\**;obj-cuda\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
