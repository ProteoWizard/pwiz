<Project>

  <!-- Stamps the Skyline version into an assembly built with GenerateAssemblyInfo=false:
       Skyline(-daily) and SkylineCore both import this, because Install reads the version from
       SkylineCore while the exe must report the same one. Values come from the central
       SkylineVersion.targets (also consumed by standalone tools that must stamp the same version);
       the AssemblyInformationalVersion carries the "(developer build)"/"(automated build)"
       suffix Install strips. Override with -p:SkylineInformationalVersion=... . -->
  <Import Project="SkylineVersion.targets" />

  <!-- Net8Version.g.cs is rewritten only when the values stamped into it change, the way the SDK's
       own GenerateAssemblyInfo works. WriteCodeFragment writes its file unconditionally, so running
       it on every build left Net8Version.g.cs newer than the assembly every time, and the project -
       with everything that references it - recompiled on every build, however small the change.
       The inputs cache below is rewritten only when its content differs, and gates the target. -->
  <Target Name="_WriteNet8VersionInputsCache"
          DependsOnTargets="ComputeSkylineVersion">
    <WriteLinesToFile File="$(IntermediateOutputPath)Net8Version.inputs.cache"
                      Lines="$(SkylineNumericVersion);$(SkylineInformationalVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Net8Version.inputs.cache" />
    </ItemGroup>
  </Target>
  <Target Name="StampNet8InformationalVersion"
          DependsOnTargets="ComputeSkylineVersion;_WriteNet8VersionInputsCache"
          BeforeTargets="CoreCompile"
          Inputs="$(IntermediateOutputPath)Net8Version.inputs.cache"
          Outputs="$(IntermediateOutputPath)Net8Version.g.cs">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(SkylineNumericVersion)</_Parameter1>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(SkylineNumericVersion)</_Parameter1>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(SkylineInformationalVersion)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(AssemblyAttribute)"
                       Language="C#"
                       OutputFile="$(IntermediateOutputPath)Net8Version.g.cs" />
    <!-- Added here rather than from the task's Output: when the target is skipped as up to date,
         MSBuild still evaluates its item groups but does not run the task, so this is what keeps
         the existing file in the compile. -->
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Net8Version.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)Net8Version.g.cs" />
    </ItemGroup>
  </Target>

</Project>
