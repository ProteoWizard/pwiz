<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce publish profile for net8 Skyline-daily, publishing to the official location.

  The legacy csproj carried its ClickOnce settings inline (PublishUrl, Install,
  ApplicationVersion, GenerateManifests, ...) and was published by hand from Visual
  Studio's Publish Wizard. .NET 5+ ClickOnce replaced that with a publish profile, so
  those settings live here instead, and the publish runs from the command line:

      pwiz_tools\Skyline\Publish-ClickOnce.ps1

  Do NOT add a second .pubxml for a different location without reading the note on
  deployment identity below - two profiles that publish the SAME identity to two URLs
  cannot both be installed on one machine.

  Deployment identity
  ==================
  ClickOnce keys an installed app by name + culture + publicKeyToken + processorArchitecture,
  NOT by URL. An official build of this profile therefore carries the SAME identity as the
  published net472 Skyline-daily, which is the point: an installed net472 client takes it as
  an in-place UPDATE and carries its settings forward. It is also the hazard - anything built
  and signed from here IS Skyline-daily to every machine that already has one. That means:
    - AssemblyName must stay Skyline-daily (it is, via MSBuildAssemblyName).
    - The certificate decides the publicKeyToken, so it decides the identity. Only a build
      signed with the official University of Washington certificate has the real one; see
      ManifestCertificateThumbprint below and Publish-ClickOnce.ps1 -KeyLocker.
    - processorArchitecture stays msil even though RuntimeIdentifier is win-x64: the
      ClickOnce entry point is the AnyCPU Launcher.exe, not the apphost. MSBuild says so
      itself - "Manifest platform should always be MSIL for Launcher-based deployments"
      (Microsoft.Common.CurrentVersion.targets).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- ClickOnce for .NET requires a RID-specific publish (it needs an apphost to launch).
         Framework-dependent, not self-contained: the helper exes Skyline shells out to
         (SkylineCmd, SkylineProcessRunner, msconvert, bullseye-sharp) are all
         framework-dependent net8 apps, so a self-contained Skyline would start on a machine
         with no runtime and then every one of those helpers would fail to launch. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun>False</PublishReadyToRun>

    <!-- Local staging only. Nothing here uploads; the tree is copied to the web server by
         hand. PublishUrl is ignored by a command-line publish (Visual Studio uses it for the
         second, IDE-only copy step) - InstallUrl/UpdateUrl are what land in the manifest. -->
    <PublishDir>publish\</PublishDir>
    <PublishUrl>publish\</PublishUrl>

    <!-- Where users install from, and where the installed app looks for updates. UpdateUrl -
         falling back to InstallUrl, then PublishUrl - becomes <deploymentProvider> in the
         .application, and the deploymentProvider WINS over whatever URL the manifest was
         actually fetched from. So this value, not the download location, decides where an
         installed client goes.
         Blanking BOTH (and only then, because Microsoft.Common.CurrentVersion.targets re-derives
         a provider for an installed app that checks for updates, which UpdateEnabled=false rules
         out) produces a deployment with no provider at all, installable straight out of an
         extracted folder. That is how the net472->net8 upgrade was tested from a ZIP; it is not
         how an official build ships. -->
    <InstallUrl>https://skyline.gs.washington.edu/software/Skyline-daily13-64/</InstallUrl>
    <UpdateUrl>https://skyline.gs.washington.edu/software/Skyline-daily13-64/</UpdateUrl>
    <SupportUrl>https://skyline.ms/support.url</SupportUrl>

    <Install>true</Install>
    <!-- Matches the published net472 preview, which has no <subscription> element: the
         ClickOnce launcher never checks on its own, Skyline's own UpgradeManager does the
         checking. Note that UpgradeManager is a no-op on net8 until the ApplicationDeployment
         replacement lands, so a net8 client currently will not self-update. -->
    <UpdateEnabled>false</UpdateEnabled>

    <!-- Shortcut name and Start menu folder, both matching the published net472 Skyline-daily so
         an in-place upgrade lands where the existing shortcut already is. -->
    <ProductName>Skyline-daily</ProductName>
    <PublisherName>MacCoss Lab, UW</PublisherName>

    <GenerateManifests>true</GenerateManifests>
    <!-- The DEVELOPER default: a self-signed cert (CN=Skyline-daily Preview (Self-Signed)) so a
         publish can be exercised without the official key. It must be in CurrentUser\My; import
         it from SkylineDailyPreviewSelfSigned.pfx (Publish-ClickOnce.ps1 checks and says how).
         A build signed with it is NOT Skyline-daily - the publicKeyToken differs, so it cannot
         update a real install.
         An OFFICIAL build overrides this: Publish-ClickOnce.ps1 -KeyLocker reads the thumbprint
         out of the University of Washington .crt and signs through the DigiCert Signing Manager
         KSP, whose private key is in the cloud HSM rather than on the machine. There is no
         thumbprint to hardcode here, because the certificate file is not in the tree.
         SignManifests stays on: it is verified load-bearing for a smooth ClickOnce install and
         is NOT redundant with the dotnet-mage signing that -KeyLocker adds on top. -->
    <SignManifests>true</SignManifests>
    <ManifestCertificateThumbprint>21DDA5E4C6249E759D0899DF536ADD2E1E8818A5</ManifestCertificateThumbprint>

    <!-- setup.exe, carrying the .NET 8 Desktop Runtime as a prerequisite. This is what makes the
         deployment installable on a machine that has no .NET 8 - activating the .application
         directly only works where the runtime is already present.

         GenerateBootstrapper searches ONE root for both its Engine\setup.bin and its Packages\,
         defaulting to "%ProgramFiles(x86)%\Microsoft SDKs\ClickOnce Bootstrapper\" - which still
         only carries the .NET Framework-era packages. The .NET 8 package ships separately under
         Visual Studio's MSBuild\Microsoft\VisualStudio\BootstrapperPackages. Publish-ClickOnce.ps1
         stages a root containing both and points GenerateBootstrapperSdkPath at it.

         IsWebBootstrapper=true puts InstallUrl into setup.exe as its ApplicationUrl, so setup.exe
         fetches the .application from the web. Set it FALSE only together with a blank InstallUrl,
         for a deployment installed out of an extracted folder; false here with InstallUrl set
         would leave setup.exe with no URL at all, and true with InstallUrl BLANK is worse still -
         _DeploymentApplicationUrl then falls back to PublishUrl and bakes a file:// path to the
         publishing machine into setup.exe.
         It does NOT decide where the prerequisite comes from - that is ComponentsLocation, left at
         its HomeSite default, so setup.exe downloads the ~60 MB runtime installer from Microsoft
         at install time rather than carrying it (the package's own CopyAllPackageFiles="false"
         would rule out carrying it in any case). -->
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <IsWebBootstrapper>true</IsWebBootstrapper>

    <!-- No CreateWebPageOnPublish/WebPage here on purpose: those are handled by Visual Studio's
         own publish step, not by MSBuild (neither property appears anywhere in
         Microsoft.Common.CurrentVersion.targets), so in a command-line publish they are dead
         config that looks like it works. Publish-ClickOnce.ps1 writes index.html instead. -->


    <!-- Skyline deploys the whole output tree of each bundled tool (msconvert, bullseye-sharp,
         BlibBuild/BlibFilter, SkylineProcessRunner), and those trees each carry their own copy
         of the shared vendor payload - MassLynxRaw.dll, the Sciex DataService*.config files, the
         runtimes\<rid>\native\* natives, and so on. A plain build tolerates that (the copies just
         overwrite each other); publish refuses to choose and fails with NETSDK1152.

         Verified before suppressing rather than assumed: all 167 colliding RELATIVE PATHS are
         byte-identical across their sources, so whichever copy wins is the same file. Note the
         check has to group by relative path, not by filename - hdf5.dll, hdf5_hl.dll and
         SQLite.Interop.dll do differ between runtimes\win-x64 and runtimes\win-x86, but those
         land at different relative paths and never collide.

         TODO: that invariant is only checked as of this commit. It wants a real test - a
         genuinely different file appearing at a colliding relative path would now be resolved
         silently, which is the class of payload bug the legacy PublishFile list existed to catch. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>

    <!-- ApplicationVersion is set by the SetClickOnceApplicationVersion target in
         Skyline.csproj, from the same git-date-derived version the assembly is stamped with.
         The legacy project hand-edited it per release; this cannot drift. -->
    <ApplicationRevision>0</ApplicationRevision>
  </PropertyGroup>

  <ItemGroup>
    <!-- Identified by ProductCode, from the package's product.xml - NOT by its folder name
         (net8desktopruntime_x64), which is what MSB3155 "could not be located" means if you get
         this wrong. -->
    <BootstrapperPackage Include="Microsoft.NetCore.DesktopRuntime.8.0.x64">
      <Visible>False</Visible>
      <ProductName>.NET Desktop Runtime 8.0 (x64)</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
  </ItemGroup>
</Project>
