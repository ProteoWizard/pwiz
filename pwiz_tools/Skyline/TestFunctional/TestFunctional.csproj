<Project Sdk="Microsoft.NET.Sdk">

  <!-- TestFunctional - Skyline functional (UI-driving) MSTest assembly. Multi-target
       net472 + net10.0-windows. No .resx/designer and no real UIAutomation usage; test
       fixtures are flat *.zip files copied to output. Compile items are auto-globbed. -->
  <PropertyGroup>
    <ProjectGuid>{1B7E62FF-463B-4B3E-8E37-72F1A7C2BFD9}</ProjectGuid>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.SkylineTestFunctional</RootNamespace>
    <AssemblyName>TestFunctional</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1605;NU1701;NU1903;SYSLIB0011</NoWarn>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!-- Fixtures + app config land next to the assembly for AbstractUnitTest.GetTestPath. -->
  <ItemGroup>
    <None Include="*.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="App.config" />
    <EmbeddedResource Include="ExportMethodDialogThermoTest.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\BiblioSpec\BiblioSpec.csproj" />
    <ProjectReference Include="..\..\Shared\CommonFileDialogs\CommonFileDialogs.csproj" />
    <ProjectReference Include="..\..\Shared\CommonMsData\CommonMsData.csproj" />
    <ProjectReference Include="..\..\Shared\CommonUtil\CommonUtil.csproj" />
    <ProjectReference Include="..\..\Shared\Common\Common.csproj" />
    <ProjectReference Include="..\..\Shared\MSGraph\MSGraph.csproj" />
    <ProjectReference Include="..\..\Shared\PanoramaClient\PanoramaClient.csproj" />
    <ProjectReference Include="..\..\Shared\ProteomeDb\ProteomeDb.csproj" />
    <ProjectReference Include="..\..\Shared\ProteowizardWrapper\ProteowizardWrapper.csproj" />
    <ProjectReference Include="..\..\Shared\zedgraph\ZedGraph.csproj" />
    <ProjectReference Include="..\CommonTest\CommonTest.csproj" />
    <ProjectReference Include="..\Skyline.csproj" />
    <ProjectReference Include="..\SkylineTool\SkylineTool.csproj" />
    <ProjectReference Include="..\TestRunnerLib\TestRunnerLib.csproj" />
    <ProjectReference Include="..\TestUtil\TestUtil.csproj" />
  </ItemGroup>

  <!-- net8: managed test + support packages; DigitalRune docking, Grpc, Parquet, DotNetZip,
       ServiceModel etc. flow transitively through the Skyline/Shared ProjectReferences. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.66" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="MathNet.Numerics" Version="4.15.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NHibernate" Version="5.5.2" />
    <PackageReference Include="Iesi.Collections" Version="4.0.5" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- Raw assembly references don't flow transitively through Skyline's ProjectReference,
         so reference DigitalRune (docking types used directly in these tests) here too. -->
    <Reference Include="DigitalRune.Windows.Docking"><HintPath>..\..\Shared\Lib\DigitalRune.Windows.Docking.dll</HintPath></Reference>
  </ItemGroup>

  <!-- net472: legacy assembly references, kept verbatim so the existing build path is unchanged. -->

  <!-- ConstantNeutralLossTest imports Agilent's RS080806_NL_448.2_001.d, which is not in git -
       it ships inside Reader_Agilent_Test.data.tar.bz2, and clean.bat removes any extracted
       copy (see TestData.csproj for the whole story). Unpack it the same way pwiz-sharp's
       reader test projects do. -->
  <ItemGroup>
    <VendorTestArchives Include="$(MSBuildThisFileDirectory)..\..\..\pwiz\data\vendor_readers\Agilent\Reader_Agilent_Test.data.tar.bz2">
      <Parent>$(MSBuildThisFileDirectory)..\..\..\pwiz\data\vendor_readers\Agilent</Parent>
    </VendorTestArchives>
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\pwiz-sharp\build\ExtractTestData.targets" />

</Project>
