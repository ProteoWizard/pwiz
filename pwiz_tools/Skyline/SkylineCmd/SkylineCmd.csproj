<Project Sdk="Microsoft.NET.Sdk">

  <!-- SkylineCmd - runs Skyline commands through SkylineCore alone, so it targets plain net10.0
       and needs no Windows Desktop runtime. It is deployed beside Skyline (see Skyline.csproj's
       _DeploySkylineCmd), where SkylineCore and its dependencies already are, and shares
       Skyline's user.config, which PortableSettingsProvider finds beside SkylineCore.dll. -->
  <PropertyGroup>
    <ProjectGuid>{FA16A0EF-EDF7-4515-BD93-44BADD7AB98A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>pwiz.SkylineCmd</RootNamespace>
    <AssemblyName>SkylineCmd</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1605;NU1701</NoWarn>
    <!-- SkylineCmd is the host process, so its runtimeconfig decides the collector Skyline runs
         under. The <gcServer> element in app.config only applies to .NET Framework; see Skyline.csproj. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkylineCore\SkylineCore.csproj" />
  </ItemGroup>

</Project>
