<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <runtime>
    <!-- AutoGenerateBindingRedirects writes the version redirects into TestData.dll.config,
         which is the config a Test Explorer run uses, so do not add those here.
         Two things it cannot supply. A codeBase must be written by hand: the assembly's
         simple name is "Parquet" but its file is ParquetNet.dll, because a native
         parquet.dll already owns that name in the output folder. And System.Text.Json is
         not in this project's reference closure, so no redirect is generated for it even
         though ParquetNet needs one. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Parquet" publicKeyToken="d380b3dee6d01926" culture="neutral" />
        <codeBase version="4.0.0.0" href="ParquetNet.dll" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.5" newVersion="8.0.0.5" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
