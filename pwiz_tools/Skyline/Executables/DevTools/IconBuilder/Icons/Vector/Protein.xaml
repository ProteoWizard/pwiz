<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Protein helix ribbon running from the upper left to the lower right: one blue outline
       traced from the bitmap's coverage, lit from the upper right with a dark navy lower-left edge
       and a few pale highlight spots. The same outline is reused by ProteinDecoy and ProteinUI. -->
  <Path Data="M 6,2 L 14,2 L 16,4 L 16,6 L 10,12 L 20,12 L 20,18 L 18,20 L 28,20 L 28,26 L 26,30 L 22,30 L 20,26 L 14,26 L 10,22 L 10,18 L 12,16 L 6,16 L 4,14 L 4,8 L 8,4 Z"
        Stroke="#1A3A9A" StrokeThickness="1" StrokeLineJoin="Round">
    <Path.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2992FF" Offset="0"/>
        <GradientStop Color="#0865F7" Offset="0.3"/>
        <GradientStop Color="#0845FF" Offset="0.55"/>
        <GradientStop Color="#0024C6" Offset="0.8"/>
        <GradientStop Color="#00109C" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
  </Path>
  <!-- Dark lower-left edges -->
  <Rectangle Canvas.Left="4" Canvas.Top="10" Width="2" Height="4" Fill="#00246B" Opacity="0.8"/>
  <Rectangle Canvas.Left="10" Canvas.Top="18" Width="2" Height="4" Fill="#001C7B" Opacity="0.8"/>
  <Rectangle Canvas.Left="12" Canvas.Top="22" Width="2" Height="2" Fill="#00105A" Opacity="0.8"/>
  <!-- Highlights -->
  <Ellipse Canvas.Left="6" Canvas.Top="4" Width="4" Height="2" Fill="#94BAF7"/>
  <Ellipse Canvas.Left="10" Canvas.Top="12" Width="2" Height="4" Fill="#7BC7FF"/>
  <Ellipse Canvas.Left="16" Canvas.Top="16" Width="2" Height="2" Fill="#7BBAFF"/>
  <Ellipse Canvas.Left="18" Canvas.Top="22" Width="2" Height="2" Fill="#527DFF"/>
</Canvas>
