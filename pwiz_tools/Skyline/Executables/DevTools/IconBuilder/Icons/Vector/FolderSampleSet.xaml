<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Sample set folder: the closed Folder drawing with two capped test tubes holding red liquid
       standing in front of it. -->
  <Rectangle Canvas.Left="27" Canvas.Top="10" Width="2" Height="19" Fill="#A8A090" Opacity="0.7"/>
  <Rectangle Canvas.Left="4" Canvas.Top="28" Width="25" Height="2" Fill="#A8A090" Opacity="0.7"/>
  <Path Data="M 1,6 L 11,6 L 15,9 L 26,9 L 26,27 L 1,27 Z" Fill="#FFF2A8" Stroke="#B8860B" StrokeThickness="2" StrokeLineJoin="Miter"/>
  <Rectangle Canvas.Left="5" Canvas.Top="13" Width="21" Height="14" Stroke="#C08A10" StrokeThickness="2">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF9CC" Offset="0"/>
        <GradientStop Color="#FFE878" Offset="0.5"/>
        <GradientStop Color="#F2B830" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Path Data="M 6,14.5 L 25,14.5" Stroke="#FFFCE6" StrokeThickness="1"/>
  <!-- Left tube -->
  <Rectangle Canvas.Left="8.5" Canvas.Top="8.5" Width="5" Height="12" Fill="#FFFFFF" Stroke="#5C4A1E" StrokeThickness="1"/>
  <Rectangle Canvas.Left="9.5" Canvas.Top="12" Width="3" Height="8" Fill="#E01010"/>
  <Rectangle Canvas.Left="7.5" Canvas.Top="6.5" Width="7" Height="3" Fill="#ECECEC" Stroke="#5C4A1E" StrokeThickness="1"/>
  <!-- Right tube -->
  <Rectangle Canvas.Left="19.5" Canvas.Top="11.5" Width="5" Height="12" Fill="#FFFFFF" Stroke="#5C4A1E" StrokeThickness="1"/>
  <Rectangle Canvas.Left="20.5" Canvas.Top="15" Width="3" Height="8" Fill="#E01010"/>
  <Rectangle Canvas.Left="18.5" Canvas.Top="9.5" Width="7" Height="3" Fill="#ECECEC" Stroke="#5C4A1E" StrokeThickness="1"/>
</Canvas>
