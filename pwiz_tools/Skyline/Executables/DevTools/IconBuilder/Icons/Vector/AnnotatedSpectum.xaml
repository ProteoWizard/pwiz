  <Rectangle Canvas.Left="4" Canvas.Top="12" Width="2" Height="14" Fill="#8A2BE2"/>
  <Rectangle Canvas.Left="2" Canvas.Top="8" Width="6" Height="2" Fill="#8A2BE2"/>
  <Rectangle Canvas.Left="10" Canvas.Top="4" Width="2" Height="22" Fill="#0000FF"/>
  <Rectangle Canvas.Left="8" Canvas.Top="0" Width="6" Height="2" Fill="#0000FF"/>
  <Rectangle Canvas.Left="14" Canvas.Top="16" Width="2" Height="10" Fill="#7F7F7F"/>
  <Rectangle Canvas.Left="22" Canvas.Top="10" Width="2" Height="16" Fill="#0000FF"/>
  <Rectangle Canvas.Left="20" Canvas.Top="6" Width="6" Height="2" Fill="#0000FF"/>
  <Rectangle Canvas.Left="26" Canvas.Top="20" Width="2" Height="6" Fill="#8A2BE2"/>
  <Rectangle Canvas.Left="26" Canvas.Top="16" Width="4" Height="2" Fill="#8A2BE2"/>
</Canvas>
