<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Immediate window icon: a small window (blue title bar with a lighter band, white body
       shading to light blue, gray text rows, dark slate right and bottom edges; rows 2..13 at 1x)
       with a red exclamation mark over its left edge whose dot hangs below the bottom edge. -->
  <Rectangle Canvas.Left="4" Canvas.Top="10" Width="28" Height="16">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#D4E4F9" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Rectangle Canvas.Left="4" Canvas.Top="4" Width="28" Height="6">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8BAAEA" Offset="0"/>
        <GradientStop Color="#3972E2" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Rectangle Canvas.Left="4" Canvas.Top="6" Width="28" Height="2" Fill="#A2C2FF" Opacity="0.55"/>
  <Rectangle Canvas.Left="12" Canvas.Top="12" Width="8" Height="2" Fill="#A0A8B6"/>
  <Rectangle Canvas.Left="22" Canvas.Top="12" Width="6" Height="2" Fill="#A0A8B6"/>
  <Rectangle Canvas.Left="8" Canvas.Top="16" Width="12" Height="2" Fill="#A0A8B6"/>
  <Rectangle Canvas.Left="8" Canvas.Top="20" Width="18" Height="2" Fill="#A0A8B6"/>
  <Rectangle Canvas.Left="8" Canvas.Top="24" Width="8" Height="2" Fill="#A0A8B6"/>
  <Path Data="M 5,10 L 5,26" Stroke="#ABB9CE" StrokeThickness="2"/>
  <Path Data="M 31,10 L 31,27 L 4,27" Stroke="#364A64" StrokeThickness="2" StrokeLineJoin="Miter"/>
  <!-- Exclamation mark: a teardrop bar (round at the top, tapering toward the dot) on rows 6..11
       of the 1x grid (units 12..24) and a round dot on rows 13..14 (units 26..30), so both land on
       whole pixels at 1x; a pink highlight on the left shading to bright red on the right, as in
       the native, with a faint pink halo at the left edge -->
  <Ellipse Canvas.Left="-0.8" Canvas.Top="13.4" Width="3.2" Height="7.2" Fill="#F7B4A2" Opacity="0.7"/>
  <Ellipse Canvas.Left="0.2" Canvas.Top="26.4" Width="2.4" Height="3.6" Fill="#F7B4A2" Opacity="0.5"/>
  <Path Data="M 4.1,12 C 6.2,12 6.7,13.6 6.5,15.5 L 5.6,23.2 C 5.5,24 2.7,24 2.6,23.2 L 1.7,15.5 C 1.5,13.6 2,12 4.1,12 Z">
    <Path.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F28878" Offset="0"/>
        <GradientStop Color="#E8341B" Offset="0.5"/>
        <GradientStop Color="#E40C04" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
  </Path>
  <Ellipse Canvas.Left="1.9" Canvas.Top="26" Width="4.4" Height="4.1">
    <Ellipse.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#FA2A1A" Offset="0"/>
        <GradientStop Color="#E0180A" Offset="0.5"/>
        <GradientStop Color="#B84038" Offset="1"/>
      </LinearGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
  <Path Data="M 2.9,14 C 2.5,16 2.7,19 3.3,22" Stroke="#FBD2C8" StrokeThickness="0.7" Opacity="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
</Canvas>
