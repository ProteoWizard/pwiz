  <Rectangle Canvas.Left="6" Canvas.Top="28" Width="10" Height="2" Fill="#525252"/>
  <!-- Bonds: fluorene rings with bond length 5.2 mirrored to point left, centered at 23.05,16 -->
  <Path Data="M 18.63,16.00 L 21.68,20.21 L 26.63,18.60 L 26.63,13.40 L 21.68,11.79 Z M 21.68,20.21 L 20.60,25.29 L 24.47,28.77 L 29.41,27.17 L 30.49,22.08 L 26.63,18.60 Z M 26.63,13.40 L 30.49,9.92 L 29.41,4.83 L 24.47,3.23 L 20.60,6.71 L 21.68,11.79 Z" Stroke="#7B7B7B" StrokeThickness="1.8" StrokeLineJoin="Round"/>
