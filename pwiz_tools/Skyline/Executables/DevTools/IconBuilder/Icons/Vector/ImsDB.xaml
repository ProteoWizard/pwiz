<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Ion mobility library: a gray database cylinder lying on its side, dark top and bottom
       edges, a shaded half-ellipse cap on the left and a ringed ellipse cap on the right. -->
  <Rectangle Canvas.Left="4" Canvas.Top="8" Width="23" Height="16">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C9C9C9" Offset="0"/>
        <GradientStop Color="#E4E4E4" Offset="0.5"/>
        <GradientStop Color="#C2C2C2" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Rectangle Canvas.Left="4" Canvas.Top="8" Width="23" Height="2" Fill="#2E2E2E"/>
  <Rectangle Canvas.Left="4" Canvas.Top="22" Width="23" Height="2" Fill="#2E2E2E"/>
  <Path Data="M 4.5,8.5 A 4,7.5 0 0 0 4.5,23.5 Z" Stroke="#3A3A3A" StrokeThickness="1">
    <Path.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8E8E8E" Offset="0"/>
        <GradientStop Color="#B8B8B8" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
  </Path>
  <Ellipse Canvas.Left="23" Canvas.Top="8" Width="8" Height="16" Stroke="#2E2E2E" StrokeThickness="2">
    <Ellipse.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B9B9B9" Offset="0"/>
        <GradientStop Color="#DADADA" Offset="1"/>
      </LinearGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
</Canvas>
