<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Binding navigator "add new": a yellow plus with a gold-to-brown outline, lit from the
       upper left. Traced from the stock WinForms glyph embedded in AlignmentForm/ListDesigner:
       arms 8 units wide (2-unit outline, 4-unit interior) spanning 4..28 on both axes. -->
  <Path Data="M 13,5 L 19,5 L 19,13 L 27,13 L 27,19 L 19,19 L 19,27 L 13,27 L 13,19 L 5,19 L 5,13 L 13,13 Z" StrokeThickness="2" StrokeLineJoin="Miter">
    <Path.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF4A8" Offset="0"/>
        <GradientStop Color="#FFE070" Offset="0.5"/>
        <GradientStop Color="#F2BE32" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
    <Path.Stroke>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0A41C" Offset="0"/>
        <GradientStop Color="#B07A14" Offset="0.5"/>
        <GradientStop Color="#7A5610" Offset="1"/>
      </LinearGradientBrush>
    </Path.Stroke>
  </Path>
</Canvas>
