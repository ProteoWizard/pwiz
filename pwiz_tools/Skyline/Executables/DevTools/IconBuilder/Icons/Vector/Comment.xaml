<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Edit note: a pale yellow note with a dark khaki 2-unit border and shaded lower edge, and a
       dark-outlined yellow pencil lying diagonally across it from the upper right (red eraser, gray
       ferrule) down to a wood tip and graphite point at the lower left. -->
  <Rectangle Canvas.Left="2" Canvas.Top="8" Width="22" Height="20" RadiusX="1" RadiusY="1" Stroke="#857450" StrokeThickness="2">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDF8D2" Offset="0"/>
        <GradientStop Color="#F3E9A8" Offset="0.6"/>
        <GradientStop Color="#DCCB80" Offset="1"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Rectangle Canvas.Left="4" Canvas.Top="24" Width="18" Height="2" Fill="#A89560" Opacity="0.9"/>
  <!-- Pencil, drawn horizontally with the tip at the origin, then rotated to point down-left -->
  <Canvas>
    <Canvas.RenderTransform>
      <TransformGroup>
        <RotateTransform Angle="-47"/>
        <TranslateTransform X="12.5" Y="19.5"/>
      </TransformGroup>
    </Canvas.RenderTransform>
    <!-- Dark outline under everything -->
    <Path Data="M -1,0 L 5,-3.8 L 24.5,-3.8 L 24.5,3.8 L 5,3.8 Z" Fill="#5C4A14"/>
    <Path Data="M 0,0 L 5,-3 L 5,3 Z" Fill="#DCC69C"/>
    <Path Data="M 0,0 L 2.5,-1.5 L 2.5,1.5 Z" Fill="#1E1E1E"/>
    <Rectangle Canvas.Left="5" Canvas.Top="-3" Width="13" Height="6">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#A8841C" Offset="0"/>
          <GradientStop Color="#F6E07A" Offset="0.3"/>
          <GradientStop Color="#E3C23C" Offset="0.7"/>
          <GradientStop Color="#7E6010" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Canvas.Left="18" Canvas.Top="-3" Width="2.5" Height="6" Fill="#9CA2AA"/>
    <Rectangle Canvas.Left="20.5" Canvas.Top="-3" Width="3.5" Height="6" RadiusX="1" RadiusY="1">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#E98A7C" Offset="0"/>
          <GradientStop Color="#C83C2E" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
  </Canvas>
</Canvas>
