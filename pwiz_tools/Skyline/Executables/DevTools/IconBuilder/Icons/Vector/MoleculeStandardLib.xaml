<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Molecule lattice (same atoms and bonds as Molecule.xaml) with the black standard mark over
       the upper right and the black library mark over the lower right. -->
  <Canvas.Resources>
    <RadialGradientBrush x:Key="Atom" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
      <GradientStop Color="#EB9090" Offset="0"/>
      <GradientStop Color="#E35F5F" Offset="0.45"/>
      <GradientStop Color="#DB3434" Offset="1"/>
    </RadialGradientBrush>
  </Canvas.Resources>
  <Line X1="14" Y1="4" X2="18" Y2="8" Stroke="#6C6C6C" StrokeThickness="2"/>
  <Line X1="6" Y1="8" X2="8" Y2="14" Stroke="#6C6C6C" StrokeThickness="2"/>
  <Line X1="18" Y1="8" X2="14" Y2="14" Stroke="#6C6C6C" StrokeThickness="2"/>
  <Line X1="8" Y1="14" X2="14" Y2="14" Stroke="#8B8B8B" StrokeThickness="2"/>
  <Line X1="8" Y1="14" X2="6" Y2="20" Stroke="#7B7B7B" StrokeThickness="2"/>
  <Line X1="14" Y1="14" X2="18" Y2="20" Stroke="#575757" StrokeThickness="2"/>
  <Line X1="6" Y1="20" X2="8" Y2="24" Stroke="#8B8B8B" StrokeThickness="2"/>
  <Line X1="8" Y1="24" X2="14" Y2="24" Stroke="#848484" StrokeThickness="2"/>
  <Line X1="18" Y1="20" X2="14" Y2="24" Stroke="#6C6C6C" StrokeThickness="2"/>
  <Line X1="8" Y1="24" X2="6" Y2="28" Stroke="#767676" StrokeThickness="2"/>
  <Ellipse Canvas.Left="11.5" Canvas.Top="1.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="3.5" Canvas.Top="5.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="15.5" Canvas.Top="5.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="5.5" Canvas.Top="11.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="11.5" Canvas.Top="11.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="3.5" Canvas.Top="17.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="15.5" Canvas.Top="17.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="5.5" Canvas.Top="21.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="11.5" Canvas.Top="21.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <Ellipse Canvas.Left="3.5" Canvas.Top="25.5" Width="5" Height="5" Fill="{StaticResource Atom}"/>
  <!-- Standard mark -->
  <Rectangle Canvas.Left="22" Canvas.Top="0" Width="4" Height="4" Fill="#000000"/>
  <Line X1="29" Y1="3" X2="23" Y2="9" Stroke="#000000" StrokeThickness="2"/>
  <Rectangle Canvas.Left="26" Canvas.Top="8" Width="4" Height="4" Fill="#000000"/>
  <!-- Library mark -->
  <Rectangle Canvas.Left="24" Canvas.Top="16" Width="2" Height="14" Fill="#000000"/>
  <Rectangle Canvas.Left="20" Canvas.Top="20" Width="2" Height="10" Fill="#000000"/>
  <Rectangle Canvas.Left="28" Canvas.Top="24" Width="2" Height="6" Fill="#000000"/>
  <Rectangle Canvas.Left="18" Canvas.Top="28" Width="12" Height="2" Fill="#000000"/>
</Canvas>
