<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Background proteome traced from the original: a blue outlined cylinder (database) with a
       transparent interior, and a blue pen lying diagonally over its lower right with the light
       nib toward the cylinder. -->
  <Ellipse Canvas.Left="5" Canvas.Top="3" Width="18" Height="6" Stroke="#3488C7" StrokeThickness="2"/>
  <Path Data="M 5,6 L 5,25 A 9,3 0 0 0 23,25 L 23,6" Stroke="#3488C7" StrokeThickness="2"/>
  <Canvas>
    <Canvas.RenderTransform>
      <TransformGroup>
        <RotateTransform Angle="-45"/>
        <TranslateTransform X="16" Y="15"/>
      </TransformGroup>
    </Canvas.RenderTransform>
    <Path Data="M 0,0 L -2.5,4.5 L 2.5,4.5 Z" Fill="#E8F0FB" Stroke="#4A7CD0" StrokeThickness="0.75" StrokeLineJoin="Miter"/>
    <Rectangle Canvas.Left="-2.5" Canvas.Top="4.5" Width="5" Height="13.5" Stroke="#1C3C9C" StrokeThickness="0.75">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#C8D8F8" Offset="0"/>
          <GradientStop Color="#4994F9" Offset="0.35"/>
          <GradientStop Color="#0851EB" Offset="0.7"/>
          <GradientStop Color="#1E3AA8" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Canvas.Left="-2.5" Canvas.Top="15.5" Width="5" Height="2.5" Fill="#3B4DC1" Stroke="#1C3C9C" StrokeThickness="0.75"/>
  </Canvas>
</Canvas>
