<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Method file traced from the native 1-pixel drawing at twice its size: a 2-unit dark gray
       square frame (4..28 by 4..30) with a transparent interior, a vertical light gray bar
       2 units inside the left edge and four horizontal light gray text bars. The frame box is
       4,4 24x26 because a Rectangle's stroke is drawn inside its box. -->
  <Rectangle Canvas.Left="4" Canvas.Top="4" Width="24" Height="26" Stroke="#676767" StrokeThickness="2"/>
  <Rectangle Canvas.Left="8" Canvas.Top="8" Width="2" Height="18" Fill="#B8B8B8"/>
  <Rectangle Canvas.Left="12" Canvas.Top="12" Width="12" Height="2" Fill="#B8B8B8"/>
  <Rectangle Canvas.Left="12" Canvas.Top="16" Width="12" Height="2" Fill="#B8B8B8"/>
  <Rectangle Canvas.Left="12" Canvas.Top="20" Width="12" Height="2" Fill="#B8B8B8"/>
  <Rectangle Canvas.Left="12" Canvas.Top="24" Width="12" Height="2" Fill="#B8B8B8"/>
</Canvas>
