      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
        <GradientStop Color="#FBF3B0" Offset="0"/>
        <GradientStop Color="#F7E79A" Offset="0.4"/>
        <GradientStop Color="#F2C232" Offset="0.75"/>
        <GradientStop Color="#D49600" Offset="1"/>
