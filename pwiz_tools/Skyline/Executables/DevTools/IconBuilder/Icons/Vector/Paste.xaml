        <GradientStop Color="#D3CEBC" Offset="0"/>
        <GradientStop Color="#C3B386" Offset="0.5"/>
        <GradientStop Color="#9F8D5B" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
  </Path>
