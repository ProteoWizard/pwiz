    </Rectangle.Fill>
  </Rectangle>
  <Rectangle Canvas.Left="1" Canvas.Top="26" Width="24" Height="2" Fill="#8E7E64" Opacity="0.8"/>
  <Rectangle Canvas.Left="8.5" Canvas.Top="6.5" Width="12" Height="3" RadiusX="0.5" RadiusY="0.5" Fill="#9F8D5B" Stroke="#766646" StrokeThickness="1"/>
