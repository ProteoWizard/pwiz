      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="0.5"/>
        <GradientStop Color="#D3DCE8" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
  </Path>
  <Path Data="M 25,15 L 25,20 L 30,20 Z" Fill="#D3DCE8" Stroke="#566881" StrokeThickness="2" StrokeLineJoin="Miter"/>
