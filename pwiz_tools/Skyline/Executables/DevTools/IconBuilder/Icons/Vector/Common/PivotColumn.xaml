<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="32" Height="32">
  <!-- Pivot column: one black row of dashes over three gray rows.
       Traced from the native pixels: each rectangle is a run of one color on the 2-unit grid. -->
  <Rectangle Canvas.Left="2" Canvas.Top="8" Width="6" Height="2" Fill="#000000"/>
  <Rectangle Canvas.Left="10" Canvas.Top="8" Width="6" Height="2" Fill="#000000"/>
  <Rectangle Canvas.Left="18" Canvas.Top="8" Width="6" Height="2" Fill="#000000"/>
  <Rectangle Canvas.Left="26" Canvas.Top="8" Width="4" Height="2" Fill="#000000"/>
  <Rectangle Canvas.Left="2" Canvas.Top="12" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="10" Canvas.Top="12" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="18" Canvas.Top="12" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="26" Canvas.Top="12" Width="4" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="2" Canvas.Top="16" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="10" Canvas.Top="16" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="18" Canvas.Top="16" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="26" Canvas.Top="16" Width="4" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="2" Canvas.Top="20" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="10" Canvas.Top="20" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="18" Canvas.Top="20" Width="6" Height="2" Fill="#808080"/>
  <Rectangle Canvas.Left="26" Canvas.Top="20" Width="4" Height="2" Fill="#808080"/>
</Canvas>
