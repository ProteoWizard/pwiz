        <GradientStop Color="#EAF0F4" Offset="0"/>
        <GradientStop Color="#D4DEE6" Offset="0.5"/>
        <GradientStop Color="#B4C2CC" Offset="1"/>
      </LinearGradientBrush>
    </Path.Fill>
  </Path>
