<Project Sdk="Microsoft.NET.Sdk">

  <!-- SharedBatchTest - MSTest helper library (test base classes / utilities; no [TestMethod]s of
       its own) shared by SkylineBatchTest / AutoQCTest. Multi-target net472;net10.0-windows. net472
       uses the GAC QualityTools MSTest framework + on-disk HintPath DLLs; net8 uses the MSTest
       framework NuGet + managed equivalents. Vestigial CodedUI/UITesting references dropped. -->
  <PropertyGroup>
    <ProjectGuid>{69531D2C-BAD8-4E79-9DF3-482A74D6D0BF}</ProjectGuid>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SharedBatchTest</RootNamespace>
    <AssemblyName>SharedBatchTest</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);NU1605;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Shared\CommonUtil\CommonUtil.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\CommonBaseUI\CommonBaseUI.csproj" />
    <ProjectReference Include="..\SharedBatch\SharedBatch.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="MSTest.TestFramework" Version="3.2.0" />
    <PackageReference Include="PROdotnetzip" Version="1.20.0" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
  </ItemGroup>


</Project>
