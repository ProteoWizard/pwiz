<?xml version="1.0" encoding="utf-8"?>
<srm_settings format_version="2.62" software_version="Skyline ">
  <settings_summary name="Default">
    <peptide_settings>
      <enzyme name="Trypsin" cut="KR" no_cut="P" sense="C" />
      <digest_settings max_missed_cleavages="0" />
      <peptide_prediction use_measured_rts="true" measured_rt_window="5" use_spectral_library_drift_times="false" />
      <peptide_filter start="2" min_length="6" max_length="30">
        <peptide_exclusions />
      </peptide_filter>
      <peptide_libraries pick="filter">
        <bibliospec_lite_library name="Rat (NIST) (Rat_plasma2) (Rat_plasma)" file_name_hint="rat_consensus_final_true_lib.blib" lsid="urn:lsid:proteome.gs.washington.edu:spectral_libary:bibliospec:nr:minimal:Rat (NIST) (Rat_plasma2) (Rat_plasma):ab408341-3806-4e0a-b189-19d06598f792:1.0" revision="1" />
        <bibliospec_lite_library name="Rat (GPM) (Rat_plasma2) (Rat_plasma)" file_name_hint="rat_cmp_20.blib" lsid="urn:lsid:proteome.gs.washington.edu:spectral_libary:bibliospec:nr:minimal:Rat (GPM) (Rat_plasma2) (Rat_plasma):dca70c76-3465-4a46-bc83-dfad2bd9db7f:1.0" revision="1" />
      </peptide_libraries>
      <peptide_modifications max_variable_mods="3" max_neutral_losses="1">
        <static_modifications>
          <static_modification name="Carbamidomethyl Cysteine" aminoacid="C" formula="C2H3ON" />
        </static_modifications>
        <heavy_modifications>
          <static_modification name="Label:13C" label_13C="true" explicit_decl="true" />
        </heavy_modifications>
        <heavy_modifications isotope_label="heavy2" />
        <heavy_modifications isotope_label="heavy3" />
      </peptide_modifications>
    </peptide_settings>
    <transition_settings>
      <transition_prediction precursor_mass_type="Monoisotopic" fragment_mass_type="Monoisotopic" optimize_by="None">
        <predict_collision_energy name="Thermo" step_size="1" step_count="5">
          <regression_ce charge="2" slope="0.034" intercept="3.314" />
          <regression_ce charge="3" slope="0.044" intercept="3.314" />
        </predict_collision_energy>
      </transition_prediction>
      <transition_filter precursor_charges="2" product_charges="1" fragment_types="y" fragment_range_first="ion 3" fragment_range_last="last ion - 1" precursor_mz_window="0" />
      <transition_libraries ion_match_tolerance="0.5" ion_count="4" pick_from="none" />
      <transition_integration integrate_all="true" />
      <transition_instrument min_mz="50" max_mz="1500" mz_match_tolerance="0.055" />
    </transition_settings>
    <data_settings>
      <annotation name="BioReplicate" targets="replicate" type="text" />
      <annotation name="SubjectId" targets="replicate" type="text" />
      <annotation name="MissingData" targets="peptide" type="true_false" />
      <annotation name="Condition" targets="replicate" type="value_list">
        <value>Healthy</value>
        <value>Diseased</value>
      </annotation>
      <group_comparison name="Test" control_annotation="Condition" control_value="Healthy" identity_annotation="BioReplicate" summarization_method="averaging" confidence_level="95" per_protein="true" />
    </data_settings>
    <measured_results time_normal_area="true">
