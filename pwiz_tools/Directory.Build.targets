<Project>

  <!-- Post-build assertion that the staged native payload matches the platform the output will
       run on. Imported for the whole tree rather than per-project: the mismatch it catches is a
       DISAGREEMENT between a project and something it references, so both ends have to be
       checked to see it. -->
  <Import Project="$(MSBuildThisFileDirectory)Shared\Lib\PwizTargetPlatform.targets" />

  <!-- Swaps the patched Parquet.dll in over the NuGet package's Parquet.dll after every build. -->
  <Import Project="$(MSBuildThisFileDirectory)Shared\Lib\Parquet\ParquetNet.targets" />

  <!-- CA1416 (platform-compatibility) flags Windows-only API calls. It is pure noise on
       Windows-only projects - the GUI/WinForms assemblies target net10.0-windows, so every
       Win32/WinForms call is flagged "reachable on all platforms" - but it is valuable
       signal on platform-neutral net10.0 projects, where it guards the multi-platform model
       and command-line code against Windows-only API usage that would break on Linux/macOS.
       So suppress it ONLY when the project declares a Windows target platform; leave it
       active everywhere else. Set in Directory.Build.targets (imported after the SDK
       resolves the target platform) so $(TargetPlatformIdentifier) is populated. -->
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Test-only: the TeamCity vstest logger, so per-test ##teamcity[testStarted/
       testFinished/testFailed] service messages (with suite/class organization) reach
       the TeamCity UI when tests run under a plain Command Line step (tcbuild.bat),
       mirroring pwiz-sharp/Directory.Build.targets. Gated on IsTestProject, set
       explicitly in the test csprojs so it is in scope at restore time. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="TeamCity.VSTest.TestAdapter" Version="1.0.40" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- The package build props deliver its logger DLLs to net-family TFMs but NOT to
       net10.0-windows (Skyline WinForms test projects), so vstest cannot find the
       teamcity logger there. Copy the logger assemblies to the test output explicitly
       on Windows-targeted test builds. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(TargetPlatformIdentifier)' == 'Windows'">
    <Content Include="$(PkgTeamCity_VSTest_TestAdapter)\build\_common\vstest15\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- Project references that point OUTSIDE the solution being built (the pwiz-sharp
       projects, SkylineProcessRunner) have no entry in the solution configuration, so
       MSBuild's AssignProjectConfiguration leaves them unassigned and - because
       ShouldUnsetParentConfigurationAndPlatform defaults to true inside Visual Studio and
       in solution builds - strips Configuration and Platform from the reference. The
       referenced project then answers with ITS OWN defaults: Debug, AnyCPU. A Release
       build of Skyline.sln therefore resolves pwiz-sharp\...\bin\Debug\net10.0\*.dll:
       it fails with CS0006 when no Debug build of pwiz-sharp exists, and silently links
       the Debug binaries when one does (observed 2026-09-02: a VS Release build put the
       267,776-byte Debug Pwiz.Data.MsData.dll next to Skyline-daily.exe while the
       248,320-byte Release one sat unused). Give unassigned references the solution's
       Configuration and Platform - what a csproj build (build.bat) passes down to them anyway
       - so the IDE uses the Debug or Release ProteoWizard binaries matching the configuration
       chosen in the IDE, and a solution build (Visual Studio, or the code inspection) links the
       same pwiz-sharp output build.bat does instead of a second copy under another platform.
       That is also where ReSharper looks for them: it resolves these references itself with
       the solution's Platform, which this target does not reach.

       The stripping repeats at every level: BlibBuild's reference to BiblioSpec, or
       Thermo's to Vendor.Common, is just as absent from Skyline.sln, and pwiz-sharp does
       not import this file. Fixing only the first level built BlibBuild as Release on top
       of a Debug BiblioSpec, so msparserD.dll and the Debug MascotShim.dll landed in
       BlibBuild's Release output and Skyline's msparser.dll copy failed (MSB3030). So
       ShouldUnsetParentConfigurationAndPlatform=false rides along in SetPlatform: the
       reference is invoked with that string as global properties, and global properties
       flow down to the referenced project's own references, so the whole out-of-solution
       subtree inherits Configuration and Platform the way a build.bat csproj build does.
       Command-line csproj builds carry no solution configuration and are untouched.

       Anything added to SetPlatform becomes a global property of the whole subtree, and
       pwiz-sharp's Vendor.Common.csproj (RegenerateVendorSdkPins) has to remove it again, or
       VendorPinsGenerator runs twice in one build and races itself. -->
  <Target Name="AssignOutOfSolutionProjectReferenceConfiguration"
          AfterTargets="AssignProjectConfiguration"
          Condition="'$(CurrentSolutionConfigurationContents)' != ''">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Condition="'%(ProjectReferenceWithConfiguration.SetConfiguration)' == ''">
        <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
        <SetPlatform>Platform=$(Platform);ShouldUnsetParentConfigurationAndPlatform=false</SetPlatform>
        <GlobalPropertiesToRemove />
      </ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>

  <!-- SkylineTool is AnyCPU in every build. External tools link against SkylineTool.dll and may run
       as 32-bit processes, which is why Skyline.sln maps it to Any CPU under its x64 configuration.
       An x64 csproj build (build.bat) would otherwise pass x64 down to it and make a different
       SkylineTool.dll from the one a solution build (Visual Studio, the code inspection) makes -
       and every project that references it, Skyline's test projects included, hashes that
       reference's PATH into its CoreCompileInputs.cache, so the two kinds of build would recompile
       each other's output every time they alternate. Done here rather than on the reference
       because most of those references are transitive, added by the SDK without any metadata;
       DependsOnTargets puts this after IncludeTransitiveProjectReferences has added them. SDK
       projects only: this file is imported by native projects too (Hardklor.vcxproj), which have
       no ResolvePackageDependenciesForBuild, and a false Condition skips DependsOnTargets. -->
  <Target Name="BuildSkylineToolAsAnyCPU"
          Condition="'$(UsingMicrosoftNETSdk)' == 'true'"
          DependsOnTargets="ResolvePackageDependenciesForBuild"
          BeforeTargets="AssignProjectConfiguration">
    <ItemGroup>
      <ProjectReference Condition="'%(ProjectReference.Filename)' == 'SkylineTool'">
        <SetPlatform>Platform=AnyCPU</SetPlatform>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!-- The output-path platform segment of a project this one references, for the places that
       bundle a referenced project's output by path (BlibBuild, msconvert, SkylineCmd and the rest,
       in Skyline.csproj). Referenced projects build with the referencing project's Platform -
       passed down by a csproj build, and set by the target above in a solution build - and the
       SDK puts any platform but AnyCPU into the output path, so an x64 build lands in bin\x64.
       A path hard-coded to bin\$(Configuration) misses that silently: every one of those items
       is guarded by Exists(), so the content is just left out of the build. -->
  <PropertyGroup>
    <BundledProjectPlatformDir Condition="'$(Platform)' != '' And '$(Platform)' != 'AnyCPU'">$(Platform)\</BundledProjectPlatformDir>
  </PropertyGroup>
</Project>
