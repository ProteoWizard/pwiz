<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-wide NuGet configuration. NuGet merges every nuget.config it finds walking up
  from a project directory, so this file applies to pwiz-sharp\ and pwiz_tools\ alike.

  ProteoWizard is consumed as NuGet packages that THIS tree builds (pwiz-sharp\build.bat
  packs pwiz-sharp\pwiz\src into artifacts\nuget\feed\). Two rules make that safe when a
  machine holds several pwiz checkouts:

    1. Every Pwiz.* package id is mapped to the tree-local feed and nothing else, so a
       ProteoWizard package can never be fetched from nuget.org or any other source. A tree
       whose feed is empty fails restore with "package not found" rather than borrowing a
       neighbour's build.
    2. The folder packages are extracted into is also tree-local: Directory.Build.props sets
       RestorePackagesPath under artifacts\nuget\packages\, which outranks NUGET_PACKAGES and
       any nuget.config globalPackagesFolder, so %USERPROFILE%\.nuget\packages is never
       consulted for anything this tree restores.

  Once package source mapping is present, every package must match some pattern. The "*"
  pattern on nuget.org keeps the ordinary packages (WebView2, NHibernate, HDF.PInvoke, ...)
  flowing as before; the more specific "Pwiz.*" pattern wins for ProteoWizard.
  See TODO-20260907_pwiz_local_nuget.md in pwiz-ai/todos.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Relative to this file: <repo>\artifacts\nuget\feed. Created by the pack step. -->
    <add key="pwiz-local" value="artifacts/nuget/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="pwiz-local">
      <package pattern="Pwiz.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
