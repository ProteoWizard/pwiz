<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>VendorPinsGenerator</RootNamespace>
    <AssemblyName>VendorPinsGenerator</AssemblyName>
    <!-- Build-time tool, not part of the product or solution. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Called by Vendor.Common's RegenerateVendorSdkPins through the MSBuild task, which runs it
       once per build however many configurations of Vendor.Common ask (see there). Inside a
       build it must stay the only thing that runs the generator: a second `dotnet run` of this
       project during the same build compiles into the same obj\Release\net10.0 and brings the
       race back. scripts\installer\build.ps1 runs it separately, before its builds start.

       `dotnet run` rather than building this project in the caller's build: the outer build's
       restore does not cover a project nothing references, and `dotnet run` restores it. The
       child inherits the outer build's SDK, which is correct now that the single repo-root
       global.json governs both. Scrubbing the MSBuild environment variables either broke the
       child (MSB4236) or removed variables that were never set.

       The root is passed as $(PwizRepoDir) rather than $(PwizRepoRoot), which ends in a
       backslash: for a checkout at a drive root "P:\" would reach the generator as P:" because
       a backslash before a closing quote escapes it.

       Skipped while nothing the pins come from has changed: the archives (their SHA-256), the
       pins JSON, this generator, and the last commit to touch each archive. That commit can
       change without any file changing (a commit or checkout), so the HEAD commit stands in for
       it, written to VendorPinsHeadFile only when it differs; every commit or checkout runs the
       generator once. The generated file cannot be the Outputs: the generator rewrites it only
       when its content changes, so after a no-op run it would stay older than the inputs and the
       target would never skip again. The stamp records the last run instead. The generated file
       is still an input, so deleting it (clean.bat does) brings it back.

       The archive glob is wider than the JSON's list. A change to an unpinned archive costs one
       generator run. -->
  <PropertyGroup>
    <VendorPinsHeadFile>$(BaseIntermediateOutputPath)VendorPins.head</VendorPinsHeadFile>
    <VendorPinsStampFile>$(BaseIntermediateOutputPath)VendorPins.stamp</VendorPinsStampFile>
  </PropertyGroup>
  <ItemGroup>
    <VendorPinsInput Include="$(PwizRepoRoot)vendor-archives\vendor_api_*.7z" />
    <VendorPinsInput Include="$(PwizRepoRoot)build\vendor-sdk-pins.json" />
    <VendorPinsInput Include="@(Compile);$(MSBuildProjectFullPath)" />
    <VendorPinsInput Include="$(PwizRepoRoot)pwiz\data\vendor_readers\Common\VendorSdkPins.generated.cs" />
  </ItemGroup>

  <!-- With no usable git (a source tarball, or a worktree whose gitdir this OS cannot see) the
       file holds git's error text instead, which is just as stable, and the generator keeps the
       existing pins as it always has. -->
  <Target Name="RecordVendorPinsHead">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(PwizRepoRoot)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_VendorPinsHead" />
    </Exec>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(VendorPinsHeadFile)" Lines="$(_VendorPinsHead)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="RunVendorPinsGenerator"
          DependsOnTargets="RecordVendorPinsHead"
          Inputs="@(VendorPinsInput);$(VendorPinsHeadFile)"
          Outputs="$(VendorPinsStampFile)">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectFullPath)&quot; -c Release -- &quot;$(PwizRepoDir)&quot;"
          WorkingDirectory="$(PwizRepoRoot)"
          StandardOutputImportance="low" />
    <Touch Files="$(VendorPinsStampFile)" AlwaysCreate="true" />
  </Target>
</Project>
