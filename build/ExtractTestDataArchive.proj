<Project DefaultTargets="Extract">

  <!--
    Extracts ONE test-data archive. Called by ExtractTestData.targets through the MSBuild task,
    never built directly, with two global properties:
      Archive : full path to the .tar.bz2
      Parent  : full path of the directory to extract into

    It is a project of its own so that each archive is extracted once per build. MSBuild runs a
    target once per project and set of global properties, and every other request for the same
    pair waits for that run and reuses its result. Several test projects unpack the same archive
    (Skyline's TestData and TestFunctional both need the Agilent data), and when they build in
    parallel, two tar processes writing the same files at once can leave a truncated or missing
    fixture - silently, because the exit code below has to be ignored. ExtractTestData.targets
    normalizes both paths and strips the caller's own global properties, so every caller asks
    for the same instance.

    The stamp lives here, under build\obj, one per archive rather than one per consuming
    project: whichever project extracts an archive first marks it done for all of them.
    clean.bat's `git clean -X` removes it along with the extracted fixtures.

    See ExtractTestData.targets for why this uses the checked-in bsdtar and why -k matters.
  -->

  <PropertyGroup>
    <_ExtractStamp>$(MSBuildThisFileDirectory)obj\extracted\$([System.IO.Path]::GetFileName('$(Archive)')).$([MSBuild]::StableStringHash('$(Archive)')).extracted</_ExtractStamp>
  </PropertyGroup>

  <!-- An archive a checkout does not carry is not an error; skip it rather than failing the
       build over a vendor this machine was never going to test. -->
  <Target Name="Extract"
          Condition="'$(Archive)' != '' And Exists('$(Archive)')"
          Inputs="$(Archive)"
          Outputs="$(_ExtractStamp)">
    <PropertyGroup>
      <!-- libraries/bsdtar.exe is a Windows PE; running it off-Windows fails with
           "Exec format error", and because IgnoreExitCode swallows that while the stamp
           below still gets touched, the extraction silently never happens and the fixtures
           just aren't there. Use the system tar elsewhere. GNU tar's -k errors on existing
           files rather than skipping (the reason bsdtar is used on Windows at all), so ask
           for the skip-old-files flag instead, which is the skip-quietly spelling. -->
      <_TarExe Condition="'$(OS)' == 'Windows_NT'">$(MSBuildThisFileDirectory)..\libraries\bsdtar.exe</_TarExe>
      <_TarKeepArgs Condition="'$(OS)' == 'Windows_NT'">-xkf</_TarKeepArgs>
      <_TarExe Condition="'$(OS)' != 'Windows_NT'">tar</_TarExe>
      <_TarKeepArgs Condition="'$(OS)' != 'Windows_NT'">--skip-old-files -xf</_TarKeepArgs>
    </PropertyGroup>
    <MakeDir Directories="$(Parent);$([System.IO.Path]::GetDirectoryName('$(_ExtractStamp)'))" />
    <Message Importance="high" Text="Extracting $(Archive) -&gt; $(Parent)" />
    <Exec Command="&quot;$(_TarExe)&quot; $(_TarKeepArgs) &quot;$(Archive)&quot; -C &quot;$(Parent)&quot;"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_TarExitCode" />
    </Exec>
    <!-- Windows bsdtar 2.7 exits 1 just for reporting skipped files, so its exit code says
         nothing; GNU tar exits 0 in skip-old-files mode unless something really went wrong. -->
    <Warning Condition="'$(OS)' != 'Windows_NT' and '$(_TarExitCode)' != '0'"
             Text="Extracting $(Archive) failed (exit $(_TarExitCode)); fixtures will be missing and their tests will report Inconclusive." />
    <Touch Files="$(_ExtractStamp)" AlwaysCreate="true" />
  </Target>

</Project>
