<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pwiz.Vendor.Waters</RootNamespace>
    <AssemblyName>Pwiz.Vendor.Waters</AssemblyName>
    <Description>Waters MassLynx (.raw) reader. P/Invoke bindings for Waters' native MassLynxRaw.dll.</Description>

    <!--
      MassLynx SDK 5.0.0 ships in pwiz-sharp/vendor-archives/vendor_api_Waters.7z, NOT the cpp
      tree's pwiz_aux copy. Same split as Thermo, and for the same reason: pwiz-sharp needs a
      newer SDK than the cpp tree can take. 5.0.0 drops 12 exports that the cpp Waters reader
      links against statically (centroidRaw, the MassLynx status/acquisition API, getVersionInfo),
      so replacing the shared archive would break the cpp build. P/Invoke only binds the symbols
      it actually imports, so pwiz-sharp is unaffected by the removals.

      5.0.0 is also what makes Waters work off-Windows: it ships libMassLynxRaw.so alongside the
      Windows DLL. ExtractWatersAssemblies stages whichever matches the build OS.

      Two 5.0.0 API changes are handled in the P/Invoke layer: createRawReaderFromPath gained a
      mandatory userLicense argument (see WatersRawFile.LicenseKey), and cdt.dll is gone; the
      compressed-data-cluster reader is now linked into MassLynxRaw itself.
      -->
    <WatersArchive>$(PwizVendorArchivesPath)\vendor_api_Waters.7z</WatersArchive>
    <WatersAssembliesDir>$(PwizVendorAssembliesPath)\Waters</WatersAssembliesDir>
    <WatersNativeLib Condition="'$(OS)' == 'Windows_NT'">MassLynxRaw.dll</WatersNativeLib>
    <WatersNativeLib Condition="'$(OS)' != 'Windows_NT'">libMassLynxRaw.so</WatersNativeLib>
    <WatersNativeLibArchiveDir Condition="'$(OS)' == 'Windows_NT'">vc12_x64</WatersNativeLibArchiveDir>
    <WatersNativeLibArchiveDir Condition="'$(OS)' != 'Windows_NT'">linux_x64</WatersNativeLibArchiveDir>
    <!-- $(SevenZaExe) is deliberately NOT set here: Directory.Build.props picks 7za.exe or
         7zz per OS, and hardcoding the Windows PE breaks any non-Windows build. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Waters.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Util\Util.csproj" />
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\MsData\MsData.csproj" />
  </ItemGroup>

  <!-- Without -p:IAgreeToVendorLicenses=true, the encrypted vendor archive is not extracted
       and the native DLL Content entries below are dropped. NO_VENDOR_SUPPORT compiles
       Reader_Waters without the P/Invoke surface so Read() throws but Identify() still works. -->
  <PropertyGroup Condition="'$(IAgreeToVendorLicenses)' != 'true'">
    <DefineConstants>$(DefineConstants);NO_VENDOR_SUPPORT</DefineConstants>
  </PropertyGroup>

  <Target Name="ExtractWatersAssemblies"
          Condition="'$(IAgreeToVendorLicenses)' == 'true'"
          BeforeTargets="ResolveAssemblyReferences;ResolveReferences;AssignTargetPaths"
          Inputs="$(WatersArchive)"
          Outputs="$(WatersAssembliesDir)\$(WatersNativeLib)">
    <MakeDir Directories="$(WatersAssembliesDir)" />
    <!-- Forward slashes in the archive member patterns: 7zz on non-Windows does not treat
         '\' as a separator, so a backslash pattern matches nothing and 7-Zip still exits 0. -->
    <Exec Command="&quot;$(SevenZaExe)&quot; x -y -pi-agree-to-the-vendor-licenses -o&quot;$(WatersAssembliesDir)&quot; &quot;$(WatersArchive)&quot; &quot;vendor_api/Waters/$(WatersNativeLibArchiveDir)/$(WatersNativeLib)&quot; &quot;vendor_api/Waters/license.key&quot;" StandardOutputImportance="low" />
    <!-- Flatten the extracted layout: the native lib and the license key must both sit next to
         the managed output, the first for DllImport to resolve it and the second for
         WatersRawFile.LicenseKey to find it. -->
    <Copy SourceFiles="$(WatersAssembliesDir)\vendor_api\Waters\$(WatersNativeLibArchiveDir)\$(WatersNativeLib);$(WatersAssembliesDir)\vendor_api\Waters\license.key"
          DestinationFolder="$(WatersAssembliesDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="'$(IAgreeToVendorLicenses)' == 'true'">
    <Content Include="$(WatersAssembliesDir)\$(WatersNativeLib)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>$(WatersNativeLib)</Link>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(WatersAssembliesDir)\license.key">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>license.key</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
